font pango:Iosevka NF 11

set $wallpaper $HOME/Pictures/Wallpapers/mountain-03.jpg
# The trailing color is the fallback: without it a missing wallpaper is a config error.
output * background $wallpaper fill #07080d

# Notification daemon
# https://github.com/emersion/mako
# Each daemon falls back when the preferred one is not installed (laptop: mako, fcitx5;
# desktop: dunst, ibus).
# Portals (screen sharing, file pickers) are started by D-Bus and need to see this session.
exec --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec --no-startup-id sh -c 'command -v mako >/dev/null && exec mako; exec dunst'
exec --no-startup-id sh -c 'command -v fcitx5 >/dev/null && exec fcitx5 -d --replace; exec ibus-daemon --daemonize --replace'
exec --no-startup-id sh -c 'command -v nm-applet >/dev/null && exec nm-applet'
# Clipboard history: record text and images as they are copied; $mod+v opens the picker.
exec --no-startup-id sh -c 'command -v cliphist >/dev/null && exec wl-paste --type text --watch cliphist store'
exec --no-startup-id sh -c 'command -v cliphist >/dev/null && exec wl-paste --type image --watch cliphist store'
# Sync battery charge policy to saved server-mode state on boot (literal path:
# $dot_local is defined further down, after this exec block).
exec --no-startup-id $HOME/.local/scripts/battery-charge-mode sync

# Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $dot_local $HOME/.local/scripts
set $dmenu_flags  -i -fn "Iosevka NF-16" -nb "#C4C6CD" -nf "#07080D" -sb "#004C63" -sf "#FFFFFF"


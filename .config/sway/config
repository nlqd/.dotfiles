# Laptop output
set $laptop eDP-1

# Window borders (all in on nvim colors)
# https://github.com/nshern/neovim-default-colorscheme-extras/tree/main
# class                 border  backgr. text    indicator child_border
client.focused          #004c63 #004c63 #ffffff #004c63   #004c63
client.focused_inactive #4f5258 #4f5258 #ffffff #4f5258   #4f5258
client.unfocused        #14161b #14161b #888888 #14161b   #14161b
client.urgent           #590008 #590008 #ffffff #590008   #590008

smart_gaps on
gaps inner 10

# Floating windows, as in i3. Zoom runs through Xwayland (class); the rest set their app id.
for_window [class="^zoom$"] floating enable
for_window [app_id="^zoom$"] floating enable
# The Meet call popup: titled "Meet - <code>" with no browser suffix, unlike a normal window.
# Chrome sets the title after the window opens, so a for_window title rule never sees it; float it
# when the title event arrives instead.
exec --no-startup-id sh -c 'swaymsg --monitor --type subscribe "[\"window\"]" | jq --unbuffered --raw-output "select(.change==\"new\" or .change==\"title\") | .container | select(.type==\"con\" and .app_id==\"google-chrome\" and ((.name // \"\") | test(\"^Meet - [a-z-]+$\"))) | .id" | while read -r id; do swaymsg "[con_id=$id] floating enable, resize set width 50 ppt height 80 ppt, move position center"; done'
for_window [app_id="^quicklaunch$"] floating enable, resize set width 60 ppt height 40 ppt, move position center
for_window [app_id="^claude-float$"] floating enable, resize set width 80 ppt height 60 ppt, move position center
for_window [app_id="^clip-history$"] floating enable, resize set width 70 ppt height 60 ppt, move position center

input type:keyboard {
    xkb_numlock enabled
}

input type:touchpad {
    dwt enabled
    tap enabled
    middle_emulation enabled
    scroll_factor 0.5
}

# Lid behavior: server mode keeps machine on with screen off; normal mode suspends
bindswitch --locked lid:on  exec $dot_local/sway-lid-handler close
bindswitch --locked lid:off exec $dot_local/sway-lid-handler open

# Key bindings
bindsym $mod+XF86AudioMute    exec pactl     set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioMute         exec pactl     set-sink-mute   @DEFAULT_SINK@ toggle
bindsym XF86AudioRaiseVolume  exec pactl     set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume  exec pactl     set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioPlay         exec playerctl play-pause
bindsym XF86AudioPause        exec playerctl play-pause
bindsym XF86AudioNext         exec playerctl next
bindsym XF86AudioPrev         exec playerctl previous
# wl-brightness uses the backlight (laptop) or the monitor's DDC/CI (desktop).
bindsym XF86MonBrightnessUp   exec wl-brightness +0.05, exec statusbar-poke
bindsym XF86MonBrightnessDown exec wl-brightness -0.05, exec statusbar-poke

bindsym Shift+Print exec $dot_local/wl-record
bindsym Print       exec $dot_local/wl-screenshot
bindsym $mod+Print  exec $dot_local/wl-screenshot annotate

# bindsym $mod+t           exec ~/.cargo/bin/alacritty
bindsym $mod+t           exec foot
bindsym $mod+b           exec firefox
bindsym $mod+v           exec foot --app-id=clip-history wl-cliphist
bindsym $mod+d           exec dmenu_run $dmenu_flags
bindsym $mod+Shift+d     exec i3-dmenu-desktop --dmenu='dmenu $dmenu_flags'
bindsym $mod+F7          exec $dot_local/sway-server-mode-toggle
bindsym $mod+Shift+m     exec swaymsg "output $laptop dpms toggle"
bindsym $mod+Shift+e     exec swaynag -t warning -m 'This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+Shift+x     exec swaynag -t warning -m 'Shut down the machine.' -B 'Yes, shutdown now' 'shutdown now' -B 'Yes, shutdown' 'shutdown'
bindsym $mod+Shift+z     exec $dot_local/sush

bindsym $mod+Shift+c reload
bindsym $mod+Shift+q kill

floating_modifier $mod normal
bindsym $mod+Shift+s floating toggle; resize set width 600px height 400px; move position 1300px 0px; sticky toggle

# Moving around
bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left  move left 70px
bindsym $mod+Shift+$down  move down 30px
bindsym $mod+Shift+$up    move up 30px
bindsym $mod+Shift+$right move right 70px

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Layout stuff
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+minus      split v
bindsym $mod+backslash  split h
bindsym $mod+f fullscreen
bindsym $mod+Shift+t floating toggle
bindsym $mod+Shift+b border toggle

# Scratchpad
bindsym $mod+Shift+grave move scratchpad
bindsym $mod+grave scratchpad show

bindsym $mod+Shift+y resize shrink width 70px
bindsym $mod+Shift+u resize grow height 70px
bindsym $mod+Shift+i resize shrink height 70px
bindsym $mod+Shift+o resize grow width 70px

bar swaybar_command waybar

include /etc/sway/config.d/*

# per-machine config, tracked in repo, auto-selected by hostname. A machine without a
# matching file is fine: sway only logs a debug line.
include hosts/$(hostname).conf

[Unit]
Description=hostrelay: read-only Slack access for sandboxed Claude Code sessions
Documentation=file://%h/.local/scripts/hostrelay

[Service]
Type=simple
ExecStart=%h/.local/scripts/hostrelay serve slack %h/.local/scripts/slapi --long-running watch --long-timeout 21600
Restart=always
RestartSec=2

[Install]
WantedBy=default.target

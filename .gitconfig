[push]
    autoSetupRemote = true

# Identity: by directory first, then by remote owner (later includes win), so a
# clone in the wrong folder still gets the identity its remote belongs to.
[includeIf "gitdir:~/org/"]
    path = ~/.gitconfig.personal
[includeIf "gitdir:~/experiments/"]
    path = ~/.gitconfig.personal
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:git@github.com:nlqd/**"]
    path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:git@github.com-code:**"]
    path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:https://github.com/nlqd/**"]
    path = ~/.gitconfig.personal
[includeIf "hasconfig:remote.*.url:git@github.com:EastAgile/**"]
    path = ~/.gitconfig.work
[includeIf "hasconfig:remote.*.url:https://github.com/EastAgile/**"]
    path = ~/.gitconfig.work

# A repo outside every rule above refuses to commit instead of guessing a name and email.
[user]
    useConfigOnly = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

[core]
    pager = delta

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    features = colorscheme

[delta "colorscheme"]
    minus-style                   = bold red
    minus-non-emph-style          = red
    minus-emph-style              = bold black red
    minus-empty-line-marker-style = normal red
    zero-style                    = normal
    plus-style                    = bold green
    plus-non-emph-style           = green
    plus-emph-style               = bold black green
    plus-empty-line-marker-style  = normal green
    whitespace-error-style        = reverse purple
    true-color                    = always
    line-numbers-zero-style       = dim normal
    line-numbers-minus-style      = red
    line-numbers-plus-style       = green
    line-numbers-left-style       = blue
    line-numbers-right-style      = blue
[credential "https://github.com"]
	helper = 
	helper = !/home/dungngo/.local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/dungngo/.local/bin/gh auth git-credential

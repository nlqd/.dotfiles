#:[link-attachments create] body: title url*
#:[link-attachments delete] DELETE /projects/{project_id}/stories/{story_id}/link-attachments/{link_attachment_id}
#:[links list] GET /projects/{project_id}/stories/{story_id}/links
#:[links create] POST /projects/{project_id}/stories/{story_id}/links
#:[links create] body: link_type title url*
#:[links update] PUT /projects/{project_id}/stories/{story_id}/links/{link_id}
#:[links update] body: title url*
#:[links delete] DELETE /projects/{project_id}/stories/{story_id}/links/{link_id}
#:[story_owners list_owners] GET /projects/{project_id}/stories/{story_id}/owners
#:[story_owners add_owner] POST /projects/{project_id}/stories/{story_id}/owners
#:[story_owners add_owner] body: agent_id member_id
#:[story_agents remove_agent_owner] DELETE /projects/{project_id}/stories/{story_id}/owners/agents/{agent_id}
#:[story_owners remove_owner] DELETE /projects/{project_id}/stories/{story_id}/owners/{member_id}
#:[reject reject_story] POST /projects/{project_id}/stories/{story_id}/reject
#:[restart restart_story] POST /projects/{project_id}/stories/{story_id}/restart
#:[reviews list] GET /projects/{project_id}/stories/{story_id}/reviews
#:[reviews create] POST /projects/{project_id}/stories/{story_id}/reviews
#:[reviews create] body: comment reviewer_agent_id reviewer_id
#:[reviews update] PUT /projects/{project_id}/stories/{story_id}/reviews/{review_id}
#:[reviews update] body: comment status*
#:[reviews delete] DELETE /projects/{project_id}/stories/{story_id}/reviews/{review_id}
#:[tasks list] GET /projects/{project_id}/stories/{story_id}/tasks
#:[tasks create] POST /projects/{project_id}/stories/{story_id}/tasks
#:[tasks create] body: complete description task_desc task_order
#:[tasks get] GET /projects/{project_id}/stories/{story_id}/tasks/{task_id}
#:[tasks update] PUT /projects/{project_id}/stories/{story_id}/tasks/{task_id}
#:[tasks update] body: complete description task_desc task_order
#:[tasks delete] DELETE /projects/{project_id}/stories/{story_id}/tasks/{task_id}
#:[stories transition] POST /projects/{project_id}/stories/{story_id}/transitions
#:[stories transition] body: to*
#:[unarchive unarchive] POST /projects/{project_id}/stories/{story_id}/unarchive
#:[transfer-organization transfer_organization] POST /projects/{project_id}/transfer-organization
#:[transfer-organization transfer_organization] body: anonymize_members copy_members target_organization_id*
#:[short-links resolve_short_link] GET /short-links/{code}
#:[story-references resolve] GET /story-references
#:[story-references resolve] query: codes ids
#:[story_states list_story_states] GET /story_states
#:[story_types list_story_types] GET /story_types
# <<< EA_API

# Build a JSON body from --key value pairs. Values coerce via JSON (numbers,
# booleans, arrays, objects); anything that is not valid JSON stays a string.
# try/catch, not `fromjson? //`: jq's // also falls back on parsed false/null.
build_body() {
  local json='{}' pair k v
  for pair in "$@"; do
    k="${pair%%=*}"; v="${pair#*=}"
    json=$(jq --arg k "$k" --arg v "$v" '. + {($k): ($v | (try fromjson catch $v))}' <<<"$json")
  done
  echo "$json"
}

# Pretty renderers keyed by "entity action"; default dumps JSON for piping.
# estimate is an effort-scale object ({label,value,order,allow_points}) once a
# story is estimated, and null otherwise; older scales sent a bare scalar.
# Passing "project" as the first arg prefixes the project title (`ea mine`).
story_line() {
  local project="${1:-}"
  jq -r --arg project "$project" '(.items? // .) | .[]? |
    (if $project == "project" then "\(.project_title // .project_id)\t" else "" end) +
    "[\(.story_id)]\t\(.story_ref)\t\(.current_state)\t\(.story_type[0:4])\t" +
    "\((.estimate | if type == "object" then (.label // .value) else . end) // "-")\t" +
    "\((.owners // []) | map(.actor.initials // .actor.name) | join(",") | if .=="" then "-" else . end)\t" +
    "\(.title)" +
    (if (.blocker_count // 0) > 0 then "  blocked:\(.blocker_count)" else "" end) +
    (if (.tasks_count // 0) > 0 then "  tasks:\(.tasks_complete_count)/\(.tasks_count)" else "" end)'
}
render_story_detail() {
  jq -r '
    "Ref:        \(.story_ref)  (id \(.story_id))",
    "Share:      \(if .short_link_code then "https://eastagiletracker.com/s/\(.short_link_code)" else "-" end)",
    "Title:      \(.title)",
    "Type:       \(.story_type)   State: \(.current_state)   Estimate: \((.estimate | if type == "object" then (.label // .value) else . end) // "-")",
    "Priority:   \(.priority_name // "-")   Icebox: \(.icebox)   Labels: \((.labels // []) | map(.label_name) | join(", "))",
    "Owners:     \((.owners // []) | map(.actor.name) | join(", ") | if .=="" then "-" else . end)",
    "",
    "Description:",
    (.description // "(none)"),
    "",
    "Tasks:",
    ((.tasks // []) | if length==0 then "  (none)" else (.[] | "  [\(if .complete then "x" else " " end)] (\(.task_id)) \(.task_desc)") end),
    "",
    "Blockers:",
    ((.blockers // []) | if length==0 then "  (none)" else (.[] | "  - \(.description // .)") end)'
}
events_tsv() {
  jq -r '(.items? // .) | .[]? | "\(.created_at)\t\(.actor.name // .actor // "?")\t\(.event_type)\t\(.target_type) \(.target_id)"'
}
# One notification per line: unread marker, feed id (nt-N, usable as a path arg
# for `ea ack ack_notification`), time, actor, kind, story ref, title.
notif_line() {
  jq -r '(.items? // .) | .[]? |
    "\(if .read_at then " " else "*" end)\t\(.id)\t\((.created_at // "")[0:16] | sub("T"; " "))\t" +
    "\(.payload.actor.initials // .payload.actor.name // "?")\t" +
    "\(.kind)\(if .payload.to_state then " ->\(.payload.to_state)" else "" end)\t" +
    "\(.payload.story.ref // "-")\t" +
    "\(.payload.story.title // .payload.project.title // "")" +
    (if .payload.comment.preview then "  \"\(.payload.comment.preview[0:60])\"" else "" end)'
}
render() {
  case "$1 $2" in
    "stories list")      story_line | tab 7 ;;
    "stories get")       render_story_detail ;;
    "stories transition")
      local body; body=$(cat)
      jq -r '"-> \(.current_state)  [\(.story_ref)]"' <<<"$body"
      local st; st=$(jq -r '.current_state // empty' <<<"$body")
      case "$st" in accepted|delivered|finished|rejected)
        echo "  Tip: attach the PR with: ea links create <ref> --url <url>" ;;
      esac ;;
    "links list")
      jq -r '(.items? // .) | .[]? | "[\(.id // .link_id)]\t\(.url)"' | tab 2 ;;
    "links create")
      jq -r '"linked [\(.id // .link_id)] \(.url)"' ;;
    "events list")       events_tsv | tab 4 ;;
    "notifications list_my_notifications") notif_line | tab 7 ;;
    "search search")
      # Search returns {results, total, limit, offset}, not the {items} every
      # other list endpoint returns, so story_line needs the key renamed.
      local body; body=$(cat)
      jq -c '{items: .results}' <<<"$body" | story_line | tab 7
      jq -r 'if (.total // 0) > ((.results | length) + (.offset // 0))
             then "  \((.results|length)) of \(.total) - page with --offset \((.results|length) + (.offset // 0))"
             else empty end' <<<"$body" ;;
    *)                   jq . ;;
  esac
}

# Generic dispatch: route by grepping the manifest, bind path params positionally,
# turn --flags into a query string (GET) or JSON body (POST/PUT).
dispatch() {
  local pid; pid=$(project_id)
  [[ -n ${1:-} ]] || { cmd_help; return; }
  local entity="$1"; shift

  # `ea labels` alone (no action) is shorthand for the curated list view.
  [[ $entity == labels && -z ${1:-} ]] && { cmd_labels "$pid"; return; }

  [[ -n ${1:-} ]] || { entity_help "$entity"; return; }
  local action="$1"; shift
  [[ $action == --help || $action == -h || $action == help ]] && { entity_help "$entity"; return; }

  # Curated wrappers: nicer rendering (labels list) or a safety-constrained write
  # (labels recolor - see cmd_labels) or a UX shortcut (stories owner - ref
  # resolution + config default). Everything else for these entities (labels
  # create/get/update/delete, the story-label-attach actions, etc.) is plain
  # generated API surface and falls through to the generic dispatch below.
  [[ $entity == stories && $action == owner ]] && { cmd_owner "$pid" "$@"; return; }
  [[ $entity == stories && $action == transfer ]] && { cmd_transfer "$pid" "$@"; return; }
  [[ $entity == labels && ($action == list || $action == recolor) ]] && { cmd_labels "$pid" "$action" "$@"; return; }
  [[ $entity == search && $action != search ]] && { cmd_search "$action" "$@"; return; }

  local a
  for a in "$@"; do [[ $a == --help || $a == -h || $a == help ]] && { op_help "$entity" "$action"; return; }; done

  local route; route=$(grep -E "^#:\[$entity $action\][[:space:]]+(GET|POST|PUT|DELETE) " "$SELF" | head -1) || true
  [[ -n $route ]] || { echo "Unknown: ea $entity $action  (try: ea $entity help)" >&2; return 1; }
  local rest="${route#*] }" method path
  method="${rest%% *}"; path="${rest#* }"

  local -a pos=() kv=(); local want_all="" want_json=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)  want_all=1; shift ;;
      --json) want_json=1; shift ;;
      --*)    [[ $# -ge 2 ]] || { echo "Flag $1 needs a value" >&2; return 1; }
              kv+=("${1#--}=$2"); shift 2 ;;
      *)      pos+=("$1"); shift ;;
    esac
  done

  local tok val pi=0
  # A short link can point at a story in another project, so resolve the story
  # arg first (it is always the first non-project path arg) and let it override
  # pid before {project_id} is filled in.
  if [[ $path == *"{story_id}"* ]]; then
    local raw="${pos[0]:-}" tgt
    [[ -n $raw ]] || { echo "Missing path arg: story_id" >&2; op_help "$entity" "$action"; return 1; }
    tgt=$(resolve_target "$pid" "$raw") || return 1
    pid="${tgt%%$'\t'*}"; pos[0]="${tgt#*$'\t'}"
  fi
  for tok in $(grep -oE '\{[a-z_]+\}' <<<"$path" | tr -d '{}'); do
    if [[ $tok == project_id ]]; then
      val="$pid"
    else
      val="${pos[$pi]:-}"; pi=$((pi + 1))
      [[ -n $val ]] || { echo "Missing path arg: $tok" >&2; op_help "$entity" "$action"; return 1; }
    fi
    path="${path/\{$tok\}/$val}"
  done

  local resp
  if [[ $method == GET ]]; then
    local qs="" pair k v
    for pair in "${kv[@]}"; do
      k="${pair%%=*}"; v=$(jq -rn --arg v "${pair#*=}" '$v|@uri')
      qs+="${qs:+&}${k}=${v}"
    done
    [[ -n $qs ]] && path="${path}?${qs}"
    if [[ -n $want_all ]]; then resp=$(paginate "$path") || return 1
    else
      resp=$(api GET "$path") || return 1
      local got; got=$(jq 'if type=="array" then length else 0 end' <<<"$resp" 2>/dev/null || echo 0)
      (( got < 1000 )) || echo "ea: got exactly $got rows, which is the server cap; there may be more. Use --all." >&2
    fi
  elif [[ $method == DELETE ]]; then
    resp=$(api DELETE "$path") || return 1
  else
    resp=$(api "$method" "$path" "$(build_body "${kv[@]}")") || return 1
  fi
  # --json: skip the pretty renderer and emit the raw API response (the very
  # thing render() would have consumed), so it pipes cleanly into jq.
  if [[ -n $want_json ]]; then echo "$resp" | jq .
  else echo "$resp" | render "$entity" "$action"; fi
}

# ---- help (greps the manifest comments) ----
op_help() {
  echo "ea $1 $2"
  grep -F "#:[$1 $2]" "$SELF" | sed -E 's/^#:\[[^]]*\][[:space:]]+/  /'
  if grep -F "#:[$1 $2]" "$SELF" | grep -q '{story_id}'; then
    echo "  <ref>: story_ref (m99), id, or the shareable short link you send"
    echo "         to teammates: https://eastagiletracker.com/s/<code>"
  fi
}
entity_help() {
  echo "ea $1 ACTION:"
  grep -oE "^#:\[$1 [a-z_]+\][[:space:]]+(GET|POST|PUT|DELETE)" "$SELF" \
    | sed -E "s/^#:\[$1 ([a-z_]+)\].*/  \1/" | sort -u || true
  grep -E "^#@:\[$1 " "$SELF" | sed -E 's/^#@:\[[^]]+\] /  /' || true
}
cmd_help() {
  cat <<EOF
ea - East Agile Tracker CLI

Grammar:  ea [-p PID] ENTITY ACTION [path-args] [--field value ...]
Help:     ea ENTITY            list its actions
          ea ENTITY ACTION --help   show path/query/body fields
Raw JSON: ea stories list|get ... --json   skip the renderer, emit raw JSON for jq

Curated commands:
  dash            Overview: non-icebox stories grouped by state
  inbox [all]     Unread notification feed; 'all' includes already-read rows
  projects        List your projects
  whoami          Agent identity, key kind, project, allowed transitions
  mine [--role owned|requested|following] [--state S] [--all]
                  My stories across every project the token can see
  search <text> [--limit N] [--offset N]        Full-text story search
  stories owner add|rm <ref> [--member <id>]    Add/remove a story owner
  stories transfer <ref...> --to <pid> [--apply]
                  Preview (default) or move stories to another project
  labels list                                   List project labels
  labels recolor <id> --bg <hex> --text <hex>   Recolor a label (color only)
  api gen         Regenerate the API manifest from the live OpenAPI spec

Story refs: every <ref> above also accepts the tracker's Share link, the one
you send to teammates: https://eastagiletracker.com/s/9xg9wm99 (/s/<code> and
the bare 8-char code also work). Links resolve to their own project, so a
pasted link works from any directory.

API surface (generated):
EOF
  grep -oE '^#:\[[a-z_-]+ [a-z_]+\][[:space:]]+(GET|POST|PUT|DELETE)' "$SELF" \
    | sed -E 's/^#:\[([a-z_-]+) ([a-z_]+)\].*/  \1 \2/' | sort -u
}

# ---- curated commands ----
cmd_projects() {
  bar; echo "Projects"; bar
  api GET "/projects" | jq -r '.[] | "\(.project_id)\t\(.project_title)\(if .is_project_member then "" else "  (not a member)" end)"' \
    | tab 2
}

#@:[me whoami] whoami  Who the token is: agent, key kind, project, transitions
# /meta is the useful half: it reports which key kind is authenticating and the
# per-story-type state machine that `stories transition` otherwise only learns
# from a 409.
cmd_whoami() {
  local me meta pid pname hint tr
  me=$(api GET "/agent/me") || return 1
  meta=$(api GET "/meta") || meta='{}'
  pid=$(jq -r '.auth.project_id // empty' <<<"$meta")
  pname=$(name_for_pid "${pid:-0}")
  jq -r --argjson pid "${pid:-0}" --arg pname "${pname:-project ${pid:-?}}" \
        --arg kind "$(jq -r '.auth.kind // "?"' <<<"$meta")" \
        --arg key "$(jq -r '.auth.key_id // "?"' <<<"$meta")" '
    "Agent:      \(.name) (id \(.agent_id), initials \(.initials))",
    "Key:        \($kind) key #\($key)",
    "Project:    \($pname) (\($pid))",
    "Created by: \(.created_by.name // "-")",
    (if .description then "About:      \(.description)" else empty end)' <<<"$me"
  hint=$(jq -r '.hint.text // empty' <<<"$meta")
  [[ -n $hint ]] && printf '\nHint:       %s\n' "$hint"
  tr=$(jq -r '.transitions // {} | to_entries[]
    | "  \(.key): " + ([.value | to_entries[]
        | "\(.key)->\(if (.value | length) == 0 then "(none)" else (.value | join("|")) end)"] | join(", "))' <<<"$meta")
  [[ -n $tr ]] && printf '\nAllowed transitions:\n%s\n' "$tr"
}
cmd_dash() {
  local pid="$1" name; name=$(name_for_pid "$pid")
  bar; echo "Tracker dashboard: ${name:-project}"; bar; echo
  local all
  all=$(api GET "/projects/${pid}/stories?fields=story_id,story_ref,title,current_state,story_type,estimate,owners,blocker_count,tasks_count,tasks_complete_count,icebox&limit=200") || return 1
  local st block n
  for st in started unstarted finished delivered rejected; do
    block=$(echo "$all" | jq --arg s "$st" '{items: [.items[] | select(.current_state==$s and (.icebox|not))]}')
    n=$(echo "$block" | jq '.items|length')
    [[ $n -gt 0 ]] || continue
    echo "--- ${st} (${n}) ---"
    echo "$block" | story_line | tab 7
    echo
  done
}

#@:[stories mine] mine [--role owned|requested|following] [--state S] [--limit N] [--all]
# Stories I own / requested / follow, across every project the token can see
# (an ea_agent_* key is bound to one project; member sessions and ea_user_*
# keys see all). The payload carries project_id but not the title, so names
# come from /projects.
cmd_mine() {
  local role="owned" state="" limit=50 all="" want_json=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --role)  [[ $# -ge 2 ]] || { echo "--role needs a value" >&2; return 1; }; role="$2"; shift 2 ;;
      --state) [[ $# -ge 2 ]] || { echo "--state needs a value" >&2; return 1; }; state="$2"; shift 2 ;;
      --limit) [[ $# -ge 2 ]] || { echo "--limit needs a value" >&2; return 1; }; limit="$2"; shift 2 ;;
      --all)   all=1; shift ;;
      --json)  want_json=1; shift ;;
      --help|-h) echo "Usage: ea mine [--role owned|requested|following] [--state S] [--limit N] [--all]"; return 0 ;;
      *)       echo "Unknown flag: $1" >&2; return 1 ;;
    esac
  done
  case "$role" in
    owned|requested|following) ;;
    *) echo "--role must be owned, requested, or following" >&2; return 1 ;;
  esac
  local path="/me/stories?role=${role}&limit=${limit}"
  [[ -n $state ]] && path="${path}&state=${state}"
  local body
  if [[ -n $all ]]; then body=$(paginate "$path") || return 1
  else body=$(api GET "$path") || return 1; fi
  [[ -n $want_json ]] && { jq . <<<"$body"; return; }
  local names
  names=$(api GET "/projects" | jq -c 'map({key:(.project_id|tostring), value:.project_title}) | from_entries' 2>/dev/null || echo '{}')
  local n; n=$(jq '(.items // []) | length' <<<"$body")
  bar; echo "My stories: ${role}${state:+ / $state} ($n)"; bar
  [[ $n -gt 0 ]] || { echo "  (none)"; return; }
  jq -c --argjson names "$names" '{items: [.items[] | . + {
      project_title: ($names[(.project_id|tostring)] // ("project " + (.project_id|tostring))) }]}' <<<"$body" \
    | story_line project | tab 8
}


# The notification feed is unified: mentions, reviews, stories and invitations
# are categories of it, so /me/mentions is not consulted here. Clear the feed
# with `ea read-all read_all`, ack one row with `ea ack ack_notification <nt-N>`.
cmd_inbox() {
  local mode="${1:-unread}"
  case "$mode" in
    unread|all) ;;
    *) echo "Usage: ea inbox [all]" >&2; return 1 ;;
  esac
  bar; echo "Inbox"; bar
  api GET "/me/notifications/unread-count" \
    | jq -r '"unread \(.unread_count)   " + ((.by_category // {}) | to_entries | map("\(.key) \(.value)") | join("  "))'
  echo
  local path="/me/notifications?limit=50"
  [[ $mode == unread ]] && path="${path}&unread=true"
  local body; body=$(api GET "$path") || return 1
  local n; n=$(jq '(.items // []) | length' <<<"$body")
  [[ $n -gt 0 ]] || { echo "  (nothing to read)"; return; }
  notif_line <<<"$body" | tab 7
}

#@:[search search] search <text> [--limit N] [--offset N]  Full-text story search
# Shortcut that takes the query positionally. It re-enters dispatch so --json
# and the generated query params (limit, offset, sort) keep working unchanged.
cmd_search() {
  local q="$1"; shift
  dispatch search search --q "$q" "$@"
}

#@:[stories refs] <ref> also accepts the shareable short link you send to teammates (https://eastagiletracker.com/s/<code>)
#@:[stories transfer] transfer <ref...> --to <project-id> [--apply]  Move stories to another project
# New transfer API: preview is the default (read-only, shows what the move
# would drop); --apply performs it. Both endpoints want numeric story ids, so
# refs and short links are resolved first. The source is the current project;
# a link pointing elsewhere is rejected rather than silently moved.
cmd_transfer() {
  local pid="$1"; shift
  local to="" apply="" want_json="" ref tgt
  local -a refs=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --to)    [[ $# -ge 2 ]] || { echo "--to needs a project id" >&2; return 1; }; to="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      --json)  want_json=1; shift ;;
      --help|-h) echo "Usage: ea stories transfer <ref...> --to <project-id> [--apply]"; return 0 ;;
      --*)     echo "Unknown flag: $1" >&2; return 1 ;;
      *)       refs+=("$1"); shift ;;
    esac
  done
  [[ -n $to ]] || { echo "Usage: ea stories transfer <ref...> --to <project-id> [--apply]" >&2; return 1; }
  [[ $to =~ ^[0-9]+$ ]] || { echo "--to needs a numeric project id (see: ea projects)" >&2; return 1; }
  [[ ${#refs[@]} -gt 0 ]] || { echo "Missing story ref(s)" >&2; return 1; }
  local -a ids=()
  for ref in "${refs[@]}"; do
    tgt=$(resolve_target "$pid" "$ref") || return 1
    [[ ${tgt%%$'\t'*} == "$pid" ]] \
      || { echo "Story $ref is in project ${tgt%%$'\t'*}, not $pid; run from that project" >&2; return 1; }
    ids+=("${tgt#*$'\t'}")
  done
  local ids_json body
  ids_json=$(printf '%s\n' "${ids[@]}" | jq -s -c 'map(tonumber)')
  body=$(jq -nc --argjson to "$to" --argjson ids "$ids_json" '{destination_project_id:$to, story_ids:$ids}')
  local path="/projects/$pid/stories/transfer"
  [[ -z $apply ]] && path="${path}/preview"
  local resp; resp=$(api POST "$path" "$body") || return 1
  if [[ -n $want_json ]]; then echo "$resp" | jq .; return; fi
  if [[ -z $apply ]]; then
    jq -r '
      "Destination: \(.destination.project_title) (\(.destination.project_id))" + (if .blocked then "  [BLOCKED]" else "" end),
      (.stories[] |
        "",
        "[\(.story_id)] \(.title)",
        "  panel: \(.target_panel // "-")   link: https://eastagiletracker.com/s/\(.short_link_code // "")",
        (if .blocked_reason then "  blocked: \(.blocked_reason)" else empty end),
        (if ((.dropped_people // []) | length) > 0 then "  drops people: " + ([.dropped_people[] | .name] | join(", ")) else empty end),
        (if ((.removed_comments.count // 0) > 0) then "  drops comments: \(.removed_comments.count)" else empty end),
        (if .requester_replaced then "  requester replaced by the mover" else empty end),
        (if ((.epic_labels_displaced // []) | length) > 0 then "  epic labels displaced: " + ([.epic_labels_displaced[] | tostring] | join(", ")) else empty end),
        (if ((.labels_created // []) | length) > 0 then "  labels created: " + ([.labels_created[] | tostring] | join(", ")) else empty end),
        (if .estimate_cleared then "  estimate cleared" else empty end),
        (if .priority_cleared then "  priority cleared" else empty end))' <<<"$resp"
    echo
    echo "Preview only. Re-run with --apply to move."
  else
    jq -r '"Moved to \(.destination.project_title) (\(.destination.project_id))",
      (.moved[] | "  [\(.from_story_id)] -> [\(.story_id)]  \(.panel // "-")  https://eastagiletracker.com/s/\(.short_link_code // "")")' <<<"$resp"
  fi
}

#@:[stories owner] owner add|rm <ref> [--member <id>]  Add/remove a story owner
# Owners: POST/DELETE /projects/{pid}/stories/{sid}/owners[/{member_id}] (now also
# generated as story_owners/epic_owners). Kept as a wrapper for ref resolution and
# the config .member_id default; --member falls back to config .member_id.
cmd_owner() {
  local pid="$1"; shift
  local sub="${1:-}"; [[ $# -gt 0 ]] && shift
  local ref="" member=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --member) [[ $# -ge 2 ]] || { echo "--member needs a value" >&2; return 1; }
                member="$2"; shift 2 ;;
      *)        ref="$1"; shift ;;
    esac
  done
  [[ $sub == add || $sub == rm || $sub == remove ]] \
    || { echo "Usage: ea stories owner add|rm <ref> [--member <id>]" >&2; return 1; }
  [[ -n $ref ]] || { echo "Missing story ref" >&2; return 1; }
  [[ -n $member ]] || member=$(cfg .member_id)
  [[ $member =~ ^[0-9]+$ ]] || { echo "Need a numeric member id (--member or config .member_id)" >&2; return 1; }
  local tgt; tgt=$(resolve_target "$pid" "$ref") || return 1
  pid="${tgt%%$'\t'*}"; local sid="${tgt#*$'\t'}"
  if [[ $sub == add ]]; then
    api POST "/projects/$pid/stories/$sid/owners" "{\"member_id\":$member}" >/dev/null \
      && echo "Added member $member as owner of $ref"
  else
    api DELETE "/projects/$pid/stories/$sid/owners/$member" >/dev/null \
      && echo "Removed member $member as owner of $ref"
  fi
}

#@:[labels list] list  List project labels (color-coded table)
#@:[labels recolor] recolor <id> --bg <hex> --text <hex>  Recolor a label (color only)
# Labels: GET/PUT /projects/{pid}/labels[/{id}] (also in the generated manifest
# now; create/get/update/delete/list_labels/add_label/remove_label reach it via
# generic dispatch). Kept as wrappers for the color-coded table and for recolor's
# safety constraint: color fields ONLY, never label_name, or the tracker's
# auto-mode classifier reads it as a rename and denies the request.
cmd_labels() {
  local pid="$1"; shift
  local sub="${1:-list}"; [[ $# -gt 0 ]] && shift
  case "$sub" in
    list)
      api GET "/projects/$pid/labels" \
        | jq -r '(.items? // .) | sort_by(.label_name)[]
            | "[\(.label_id)]\t\(.label_name)\t\(.background_color_hex)\t\(.text_color_hex)\t\(.story_count)\(if .archived then "  (archived)" else "" end)"' \
        | tab 2 ;;
    recolor)
      local id="" bg="" text=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --bg)   [[ $# -ge 2 ]] || { echo "--bg needs a hex value" >&2; return 1; }; bg="$2"; shift 2 ;;
          --text) [[ $# -ge 2 ]] || { echo "--text needs a hex value" >&2; return 1; }; text="$2"; shift 2 ;;
          *)      id="$1"; shift ;;
        esac
      done
      [[ -n $id ]] || { echo "Usage: ea labels recolor <id> --bg <hex> [--text <hex>]" >&2; return 1; }
      [[ -n $bg || -n $text ]] || { echo "Nothing to change: pass --bg and/or --text" >&2; return 1; }
      local body; body=$(jq -nc --arg bg "$bg" --arg text "$text" '
        {} + (if $bg   != "" then {background_color_hex:$bg} else {} end)
           + (if $text != "" then {text_color_hex:$text}     else {} end)')
      api PUT "/projects/$pid/labels/$id" "$body" \
        | jq -r '"recolored [\(.label_id)] \(.label_name)  bg=\(.background_color_hex) text=\(.text_color_hex)"' ;;
    *) echo "Usage: ea labels list | ea labels recolor <id> --bg <hex> --text <hex>" >&2; return 1 ;;
  esac
}

# ---- codegen: rewrite the manifest block from the live spec ----
api_gen() {
  local spec; spec=$(api GET "/openapi.json")
  echo "$spec" | jq -e '.paths' &>/dev/null || { echo "Failed to fetch spec" >&2; return 1; }
  local block
  block=$(echo "$spec" | jq -r '
    . as $root
    | def bfields($ref):
        ($ref | sub("^#/components/schemas/"; "")) as $n
        | $root.components.schemas[$n] as $s
        | ($s.required // []) as $req
        | [ ($s.properties // {} | to_entries[]) | (.key) as $f | (.value.type) as $t
            | $f
              + (if ($t == "array") or (($t|type=="array") and ($t|index("array"))) then "[]" else "" end)
              + (if ($req|index($f)) then "*" else "" end) ];
      def singularize: if test("ies$") then sub("ies$";"y") elif test("s$") then sub("s$";"") else . end;
      def emit($E; $o):
        ( "#:[\($E) \($o.a)] \($o.m) \($o.p)" ),
        ( if ($o.q|length)>0 then "#:[\($E) \($o.a)] query: " + ($o.q|join(" ")) else empty end ),
        ( if $o.bref then "#:[\($E) \($o.a)] body: " + (bfields($o.bref)|join(" ")) else empty end );
      [ .paths | to_entries[] | .key as $p | (.value|to_entries[]) | .key as $m | .value as $op
        | ($p | sub("^/api/v1"; "") | split("/")
            | map(select(. != "" and . != "projects" and (startswith("{")|not)))) as $segs
        | (if ($segs|length)==0 then "project"
           elif ($segs[-1] | test("transition")) then $segs[-2]
           else $segs[-1] end) as $E0
        | ($op.operationId | if .=="list_events" then "list" elif .=="get_meta" then "get" else . end) as $A
        | { e0: $E0, a: $A, m: ($m|ascii_upcase), p: ($p|sub("^/api/v1";"")),
            q: ([ $op.parameters[]? | select(.in=="query") | (.name + (if .required then "*" else "" end)) ]),
            bref: ($op.requestBody.content."application/json".schema."$ref" // null) }
      ] as $ops
      # A bare entity+action name that spans more than one distinct path is ambiguous:
      # dispatch()s `grep | head -1` would silently pick one and ignore the other (this
      # happens for e.g. "owners" under epics and stories, or "bulk-role" under
      # organizations and projects). Qualify only those with the first literal path
      # segment where the clashing paths diverge; leave anything unambiguous
      # (comments, tasks, ...) using the plain name.
      | def literals: split("/") | map(select(. != "" and (startswith("{")|not)));
        ($ops | group_by(.e0 + " " + .a)
          | map(select((map(.p)|unique|length) > 1)
                | { key: (.[0].e0 + " " + .[0].a),
                    value: (map(.p | literals) as $s
                            | first(range(0; $s[0]|length) | select(. as $i | ($s | map(.[$i]) | unique | length) > 1))
                              // error("cannot disambiguate: \(.[0].e0) \(.[0].a)")) })
          | from_entries) as $diverge
      | $ops[] | . as $o
        | ($diverge[$o.e0 + " " + $o.a]) as $i
        | (if $i then (($o.p | literals)[$i] | singularize) + "_" + $o.e0 else $o.e0 end) as $E
        | emit($E; $o)')
  awk -v b="$block" '
    /^# >>> EA_API/ { print; print b; skip=1; next }
    /^# <<< EA_API/ { skip=0 }
    !skip { print }
  ' "$SELF" > "${SELF}.tmp" && chmod +x "${SELF}.tmp" && mv "${SELF}.tmp" "$SELF"
  echo "Regenerated EA_API manifest: $(echo "$block" | grep -cE '] (GET|POST|PUT|DELETE) ') operations."
}
cmd_api() {
  case "${1:-}" in
    gen) api_gen ;;
    *)   echo "Usage: ea api gen" >&2; return 1 ;;
  esac
}

main() {
  # Only leading options belong to ea itself; stop at the first positional so
  # flags like --help after the entity reach dispatch.
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -p|--project) EA_PROJECT_OVERRIDE="$2"; shift 2 ;;
      -h|--help)    cmd_help; exit 0 ;;
      --)           shift; break ;;
      *)            break ;;
    esac
  done

  case "${1:-help}" in
    help)     cmd_help ;;
    api)      shift; cmd_api "$@" ;;
    dash|d)   cmd_dash "$(project_id)" ;;
    inbox)    shift; cmd_inbox "$@" ;;
    projects) cmd_projects ;;
    whoami)   cmd_whoami ;;
    mine)     shift; cmd_mine "$@" ;;
    *)        dispatch "$@" ;;
  esac
}

main "$@"

#!/usr/bin/env bash
#
# ea - East Agile Tracker CLI (read + write). Grammar: ea ENTITY ACTION [path-args] [--field value]
#
# The API surface is generated from the live OpenAPI spec by `ea api gen` into
# the `#:[entity action]` comment block below. Those comments are the single
# source of truth: the dispatcher greps them for routing, `--help` greps them
# for docs. Routing and pretty rendering live on top, hand-written.
#
# Config: ~/.config/eatracker/config.json
#   { "agent_key": "ea_agent_...", "member_id": N,
#     "projects": [ { "local_path": "/repo", "pid": N, "name": "..." } ] }
#   member_id is the default owner for `ea stories owner add`.
#
# Unhandled from the spec (deliberate, for a personal tool):
#   - Idempotency-Key on writes: the API honours it for safe replay (and 409s on
#     a body-mismatch replay), but without an in-process retry loop a fresh key
#     per run buys nothing, so writes send none. Add a stable key + retry/backoff
#     if create/transition ever need at-least-once safety.
#   - State machine: GET /meta returns the per-type allowed transitions; we don't
#     pre-validate `stories transition --to`, so an illegal move just round-trips
#     a 409 instead of being caught locally.
#   - Sparse fieldsets: passing `--fields ...` to a list/get can starve the pretty
#     renderers (they read fields that may now be absent -> blank cells).

set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
CONFIG_FILE="${HOME}/.config/eatracker/config.json"
BASE="https://api.eastagiletracker.com/api/v1"
DEFAULT_PROJECT=14   # Jenner Analytics

bar() { printf '%.0s=' {1..60}; echo; }

# Render tab-separated stdin as a table. Optional arg is the column number to
# wrap. Only fit/wrap to a width when stdout is a real terminal; when piped or
# redirected, emit full untruncated cells so downstream tools get everything.
tab() {
  [[ -t 1 ]] || { column -t -s $'\t'; return; }
  # Read width from the controlling terminal: tput cols in a $() reads a pipe,
  # not the tty, and falls back to terminfo's stale 80.
  local w; w=$(stty size </dev/tty 2>/dev/null | awk '{print $2}')
  [[ $w =~ ^[0-9]+$ ]] || w=$(tput cols 2>/dev/null)
  [[ $w =~ ^[0-9]+$ && $w -ge 40 ]] || w=100
  column -t -s $'\t' -c "$w" ${1:+-W "$1"}
}

cfg() {
  [[ -f $CONFIG_FILE ]] || return 0
  jq -r "$1 // empty" "$CONFIG_FILE" 2>/dev/null || true
}

# Auth: agent_key from config, emitted as the X-TrackerToken request header line.
auth_header() {
  local key; key=$(cfg .agent_key)
  [[ -n $key ]] || { echo "Error: no agent_key in $CONFIG_FILE" >&2; exit 1; }
  echo "X-TrackerToken: $key"
}

name_for_pid() {
  [[ -f $CONFIG_FILE ]] || return
  jq -r --argjson p "$1" '.projects // [] | map(select(.pid == $p)) | (first // {}) | .name // empty' "$CONFIG_FILE" 2>/dev/null
}

# Project resolution: -p flag > $EA_PROJECT > the config project whose local_path
# is the longest prefix of $PWD > DEFAULT_PROJECT.
project_id() {
  [[ -n ${EA_PROJECT_OVERRIDE:-} ]] && { echo "$EA_PROJECT_OVERRIDE"; return; }
  [[ -n ${EA_PROJECT:-} ]] && { echo "$EA_PROJECT"; return; }
  local m=""
  [[ -f $CONFIG_FILE ]] && m=$(jq -r --arg pwd "${PWD}/" '.projects // []
    | map(select($pwd | startswith(.local_path + "/")))
    | sort_by(.local_path | length) | (last // empty) | .pid // empty' "$CONFIG_FILE" 2>/dev/null)
  echo "${m:-$DEFAULT_PROJECT}"
}

# Make a request; on HTTP >= 400, print the API's error message (or the raw body)
# and fail. Otherwise emit the response body. The trailing %{http_code} is split
# off the last line so the body stays intact.
api() {
  local method="${1:-GET}" path="$2" data="${3:-}"
  local args=(-sS --max-time 30 --connect-timeout 10 -X "$method" -H "$(auth_header)")
  [[ -n $data ]] && args+=(-H 'Content-Type: application/json' -d "$data")
  local out; out=$(curl "${args[@]}" -w $'\n%{http_code}' "${BASE}${path}") \
    || { echo "Request failed: $method $path" >&2; return 1; }
  local code="${out##*$'\n'}" body="${out%$'\n'*}"
  if [[ $code -ge 400 ]]; then
    local msg; msg=$(jq -re '(.error // .detail // (.errors[0]? | (.message? // .)) // empty) | tostring' <<<"$body" 2>/dev/null || true)
    echo "API error (HTTP $code): ${msg:-$body}" >&2
    return 1
  fi
  echo "$body"
}

# Fetch every page of a list endpoint (--all) and merge the items. Follows
# next_cursor when the API sends one; otherwise walks offset, because stories list
# pages by offset and returns a bare array. Pages go through temp files: a big
# accumulated array does not fit in jq's argv (the old --argjson crashed at ~1000 rows).
paginate() {
  local base="$1" sep tmp body cur="" off=0 n=0 first prev=""
  [[ $base == *\?* ]] && sep='&' || sep='?'
  tmp=$(mktemp --directory) || return 1
  while :; do
    local url="$base"
    if [[ -n $cur ]]; then url="${base}${sep}cursor=${cur}"
    elif (( off > 0 )); then url="${base}${sep}offset=${off}"; fi
    body=$(api GET "$url") || { rm --recursive --force "$tmp"; return 1; }
    n=$((n + 1))
    jq -c '.items? // .' <<<"$body" >"$tmp/$n.json" 2>/dev/null || { rm --recursive --force "$tmp"; return 1; }
    local count; count=$(jq 'if type=="array" then length else 0 end' "$tmp/$n.json")
    # single objects, empty pages and an API that ignores offset (same page again) all end the walk
    first=$(jq -c 'if type=="array" then .[0] else null end' "$tmp/$n.json")
    (( count > 0 )) || break
    [[ $first != "$prev" ]] || { rm "$tmp/$n.json"; break; }
    prev="$first"
    cur=$(jq -r '.next_cursor? // empty' <<<"$body" 2>/dev/null || true)
    if [[ -z $cur ]]; then
      jq -e 'type=="array"' <<<"$body" >/dev/null 2>&1 || [[ $body == *'"items"'* ]] || break
      off=$((off + count))
    fi
    (( n < 500 )) || { echo "paginate: stopped after 500 pages" >&2; break; }
  done
  jq -cs '{items: (add // [])}' "$tmp"/*.json
  rm --recursive --force "$tmp"
}

# Short-link code from a pasted link, or a bare code. Accepts
# https://eastagiletracker.com/s/9xg9wm99, the scheme-less /s/<code> path, and
# a bare 8-char code. Query strings and fragments are ignored.
short_code() {
  local ref="$1"
  if [[ $ref =~ ^(https?://[^/[:space:]]+)?/s/([A-Za-z0-9_-]+)/?([?#].*)?$ ]]; then
    echo "${BASH_REMATCH[2]}"; return 0
  fi
  # Exactly 8 alnum: matches today's codes, and keeps short story_refs (m99,
  # and any future 3-7 char ref) from being mistaken for one.
  [[ $ref =~ ^[A-Za-z0-9]{8}$ ]] && { echo "$ref"; return 0; }
  return 1
}

# Resolve any story reference to "PROJECT_ID<TAB>STORY_ID". Accepted forms:
# numeric id, human story_ref (m99), short-link code, short URL (/s/<code>).
# A short link carries its own project, which may differ from the caller's
# current one, so callers must adopt the returned pid.
resolve_target() {
  local pid="$1" ref="$2" code hit
  [[ $ref =~ ^[0-9]+$ ]] && { printf '%s\t%s\n' "$pid" "$ref"; return 0; }
  if code=$(short_code "$ref"); then
    # 404 (unknown/expired code, or no access) is quiet here: a bare token may
    # have been meant as a story_ref, so it falls through to the search below.
    hit=$(api GET "/short-links/${code}" 2>/dev/null) || hit=""
    if [[ -n $hit ]]; then
      jq -r '"\(.project_id)\t\(.story_id)"' <<<"$hit"; return 0
    fi
    # A pasted URL is unambiguous: don't go hunting for it as a story_ref.
    [[ $ref != "$code" ]] && { echo "Could not resolve short link: $ref" >&2; return 1; }
  fi
  # Human ref: go through search, not a stories list page - the list caps out
  # and silently misses any ref past the cap, while search indexes the whole
  # project. Search is full-text, so re-apply the exact-ref match on results.
  local q; q=$(jq -rn --arg v "$ref" '$v|@uri')
  local sid; sid=$(api GET "/projects/${pid}/search?q=${q}&limit=25" \
    | jq -r --arg r "$ref" '.results[]? | select((.story_ref | ascii_downcase) == ($r | ascii_downcase)) | .story_id' \
    | head -1)
  [[ -n $sid ]] && { printf '%s\t%s\n' "$pid" "$sid"; return 0; }
  echo "Could not resolve story: $ref" >&2
  return 1
}


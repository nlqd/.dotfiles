#!/usr/bin/env bash
set -euo pipefail

CREDS_FILE="$HOME/.config/router-monitor/creds"
TELNET_HELPER="$HOME/.local/scripts/.router-telnet.py"
WATCH_HELPER="$HOME/.local/scripts/.router-watch.py"
WIFI_EXTRACT_WAN="$HOME/.local/scripts/.router-wifi-extract-wan.js"
WIFI_EXTRACT_CLIENTS="$HOME/.local/scripts/.router-wifi-extract-clients.js"
WIFI_NOTABLE_FILTER="$HOME/.local/scripts/.router-wifi-notable.jq"
CHROME_COOKIES="$HOME/.local/scripts/chrome-cookies-linux"
RODNEY="$HOME/.local/bin/rodney"
UNIFI_CONSOLE_ID="D021F9DE36A500000000066AB68C0000000006B77EBB00000000627FFFA6:234758090"
WIFI_LOG_FILE="$HOME/.local/state/router-status/wifi.jsonl"
MAIN_LOG_FILE="$HOME/.local/state/router-status/main.jsonl"

TMPDIR="${XDG_RUNTIME_DIR:-/tmp}/router-monitor-$$"
mkdir -p "$TMPDIR"
trap 'rm -rf "$TMPDIR"' EXIT

RED='\033[0;31m'
YEL='\033[0;33m'
DIM='\033[2m'
RST='\033[0m'
BOLD='\033[1m'

case "${1:-}" in
    --setup|--teardown|wifi) ;;
    *)
        # shellcheck source=/dev/null
        source "$CREDS_FILE"
        ;;
esac

ISSUES_FILE="$TMPDIR/issues"
: > "$ISSUES_FILE"

add_issue() {
    echo "$1" >> "$ISSUES_FILE"
}

STATE_DIR="$HOME/.local/state/router-monitor"
mkdir -p "$STATE_DIR"

# --- helpers ---

telnet_cmds() {
    local host="$1" user="$2" pass="$3"
    shift 3
    ROUTER_PASS="$pass" python3 "$TELNET_HELPER" "$host" "$user" "$@"
}

format_rate() {
    local bps="$1"
    if (( bps >= 1000000 )); then
        printf "%.1fM" "$(echo "$bps / 1000000" | bc -l)"
    elif (( bps >= 1000 )); then
        printf "%.0fK" "$(echo "$bps / 1000" | bc -l)"
    else
        printf "%d" "$bps"
    fi
}

format_uptime() {
    local raw="$1"
    [[ "$raw" == "—" ]] && echo "—" && return
    local hours
    hours=$(echo "$raw" | cut -d: -f1)
    if (( hours >= 24 )); then
        printf "%dd%dh" "$((hours / 24))" "$((hours % 24))"
    else
        printf "%s" "$raw"
    fi
}

# --- collect data from .1 and .2 via telnet ---

collect_draytek() {
    local host="$1" label="$2" user="$3" pass="$4"

    local raw wan_raw wan1 session_raw arp_raw v4_raw v6_raw
    raw=$(telnet_cmds "$host" "$user" "$pass" "wan status" "show session" "ip arp status" "ip ping 8.8.8.8 WAN1" "ip6 ping 2001:4860:4860::8888 WAN1 2") || true
    wan_raw=$(echo "$raw" | sed -n '/^=== wan status ===/,/^=== show session ===/{//!p}') || true
    wan1=$(echo "$wan_raw" | sed -n '/^WAN1:/,/^WAN2:\|^USB_WAN/{p}') || true
    session_raw=$(echo "$raw" | sed -n '/^=== show session ===/,/^=== ip arp status ===/{//!p}') || true
    arp_raw=$(echo "$raw" | sed -n '/^=== ip arp status ===/,/^=== ip ping/{//!p}') || true
    v4_raw=$(echo "$raw" | sed -n '/^=== ip ping/,/^=== ip6 ping/{//!p}') || true
    v6_raw=$(echo "$raw" | sed -n '/^=== ip6 ping/,${//!p}') || true

    local status stall ip uptime tx_rate rx_rate sess_cur sess_max clients
    status=$(echo "$wan1" | grep -m1 -oP 'WAN1: \K\w+') || status="unknown"
    stall=$(echo "$wan1" | grep -m1 -oP 'stall=\K\w') || stall="?"
    ip=$(echo "$wan1" | grep -m1 -oP '(?<![A-Z]) IP=\K[0-9.]+') || ip="—"
    uptime=$(echo "$wan1" | grep -m1 -oP 'Up Time=\K[0-9:]+') || uptime="—"
    tx_rate=$(echo "$wan1" | grep -m1 -oP 'TX Rate\([Bb]ps\)=\K[0-9]+') || tx_rate="0"
    rx_rate=$(echo "$wan1" | grep -m1 -oP 'RX Rate\([Bb]ps\)=\K[0-9]+') || rx_rate="0"
    sess_cur=$(echo "$session_raw" | grep -m1 -oP '% Current Session Usage: \K[0-9]+') || sess_cur="0"
    sess_max=$(echo "$session_raw" | grep -m1 -oP 'Maximum Session Number: \K[0-9]+') || sess_max="60000"
    clients=$(echo "$arp_raw" | grep -cP '^\s+\d+\s+192\.168\.') || clients="0"

    # The DrayTek CLI occasionally drops a command's entire reply within one telnet
    # session (timing/race, not packet loss) — "?" means no attempt was observed,
    # distinct from a real failure, so a CLI hiccup can't masquerade as an outage.
    local v4_status
    if echo "$v4_raw" | grep -q 'Receive reply from'; then
        v4_status="up"
    elif echo "$v4_raw" | grep -q 'Pinging'; then
        v4_status="down"
    else
        v4_status="?"
    fi

    # ip6 ping always prints "Packets: Sent = X, Received = Y, Lost = Z", even on
    # instant failure, so Sent=0 means no v6 route at all (the current safe baseline)
    # vs Sent>0/Received=0 meaning a WAN v6 address exists but upstream is blackholed.
    local v6_sent v6_recv v6_status
    if echo "$v6_raw" | grep -q 'Packets:'; then
        v6_sent=$(echo "$v6_raw" | grep -oP 'Sent = \K[0-9]+') || v6_sent="0"
        v6_recv=$(echo "$v6_raw" | grep -oP 'Received = \K[0-9]+') || v6_recv="0"
        v6_status="off"
        if (( v6_sent > 0 )); then
            v6_status="down"
            (( v6_recv > 0 )) && v6_status="up"
        fi
    else
        v6_status="?"
    fi

    if [[ "$status" != "Online" ]]; then
        add_issue "${RED}${label}: WAN is ${status}${RST}"
    fi
    if [[ "$stall" == "Y" ]]; then
        add_issue "${RED}${label}: WAN stalled${RST}"
    fi
    if (( sess_max > 0 )); then
        local sess_pct=$(( sess_cur * 100 / sess_max ))
        if (( sess_pct > 50 )); then
            add_issue "${YEL}${label}: sessions at ${sess_pct}% (${sess_cur}/${sess_max})${RST}"
        fi
    fi
    if [[ "$v4_status" == "down" ]]; then
        add_issue "${RED}${label}: IPv4 ping to 8.8.8.8 failed${RST}"
    fi
    if [[ "$v6_status" == "down" ]]; then
        add_issue "${RED}${label}: IPv6 has a WAN address but ping is blackholed (flap in progress)${RST}"
    fi

    local up_fmt tx_fmt rx_fmt
    up_fmt=$(format_uptime "$uptime")
    tx_fmt=$(format_rate "$tx_rate")
    rx_fmt=$(format_rate "$rx_rate")

    # save raw uptime for flap detection
    echo "$uptime" > "$TMPDIR/uptime-${host##*.}"

    printf "%s\t%s\t%s\t%s\t%s\t%s/%s\t%s\t%s\t%s / %s\n" \
        "$label" "$status" "$ip" "$v4_status" "$v6_status" "$sess_cur" "$sess_max" "$clients" "$up_fmt" "$tx_fmt" "$rx_fmt"
}

# --- collect data from .3 via curl ---

ont_login() {
    local cookie_file="$TMPDIR/ont-cookies.txt"
    curl --silent --max-time 5 --insecure \
        --cookie-jar "$cookie_file" \
        "https://192.168.1.3/cgi-bin/login.asp" > /dev/null 2>&1

    curl --silent --max-time 5 --insecure \
        --cookie "$cookie_file" \
        --cookie-jar "$cookie_file" \
        --referer "https://192.168.1.3/cgi-bin/login.asp" \
        --data "Username=${ONT_USER}&Password=${ONT_PASS}&StatusActionFlag=-1" \
        "https://192.168.1.3/cgi-bin/login.asp" > /dev/null 2>&1
}

ont_get() {
    local page="$1"
    curl --silent --max-time 5 --insecure \
        --cookie "$TMPDIR/ont-cookies.txt" \
        "https://192.168.1.3/cgi-bin/$page" 2>/dev/null
}

collect_ont() {
    ont_login

    local device_raw user_raw
    device_raw=$(ont_get "sta-device.asp")
    user_raw=$(ont_get "sta-user.asp")

    if echo "$device_raw" | grep -q 'login.asp'; then
        add_issue "${RED}.3 (Viettel): login failed${RST}"
        printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
            ".3 (Viettel)" "???" "—" "—" "—" "—" "—" "—" "login failed"
        return
    fi

    local wan_status wan_ip pon_state
    wan_status=$(echo "$device_raw" | grep -oP 'vArrayStr = "\K[^"]+' | sed -n '8p' | cut -d, -f1)
    wan_ip=$(echo "$device_raw" | grep -oP 'vArrayStr = "\K[^"]+' | sed -n '9p' | cut -d, -f1)
    pon_state=$(echo "$device_raw" | grep -oP "trafficstate\s*=\s*'\K[^']+" || echo "unknown")

    local client_ips client_count
    client_ips=$(echo "$user_raw" | grep -m1 'var aryInfoTemp' | grep -oP '"\K[^"]+' || echo "")
    client_count=$(echo "$client_ips" | tr ',' '\n' | grep -c '192\.168\.' || echo "0")

    if [[ "$wan_status" != "up" ]]; then
        add_issue "${RED}.3 (Viettel): WAN is ${wan_status:-down}${RST}"
    fi
    if [[ "$pon_state" != "up" ]]; then
        add_issue "${RED}.3 (Viettel): PON link ${pon_state:-down}${RST}"
    fi

    # Homogenize status with DrayTek output: Online when WAN is up, DOWN otherwise.
    # ONT cumulative packet counters aren't comparable to DrayTek bps rates, so TX/RX is "—".
    local display_status="Online"
    [[ "$wan_status" != "up" ]] && display_status="DOWN"

    # No telnet/SNMP on the ONT (ISP-locked), so v4 reuses the WAN status scrape
    # and v6 is "n/a" rather than a guess — sta-device.asp exposes no v6 fields.
    local v4_status="down"
    [[ "$wan_status" == "up" ]] && v4_status="up"

    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
        ".3 (Viettel)" "$display_status" "${wan_ip:-—}" "$v4_status" "n/a" "—" "$client_count" "—" "—"
}

# --- DNS health check ---

dns_check_one() {
    local label="$1" bind_ip="$2"
    local ms
    ms=$(dig +time=3 +tries=1 +stats @8.8.8.8 -b "$bind_ip" google.com 2>/dev/null \
        | grep -oP 'Query time: \K[0-9]+') || ms=""
    if [[ -n "$ms" ]]; then
        printf "%s\t%sms\n" "$label" "$ms"
        if (( ms > 500 )); then
            add_issue "${YEL}${label}: DNS slow (${ms}ms)${RST}"
        fi
    else
        printf "%s\tFAIL\n" "$label"
        add_issue "${RED}${label}: DNS resolution failed${RST}"
    fi
}

start_dns_bg() {
    speed_has_bind_ips || return 0
    dns_check_one ".1" "${SPEED_BIND_IPS[0]}" > "$TMPDIR/dns-1.txt" 2>/dev/null &
    dns_check_one ".2" "${SPEED_BIND_IPS[1]}" > "$TMPDIR/dns-2.txt" 2>/dev/null &
    dns_check_one ".3" "${SPEED_BIND_IPS[2]}" > "$TMPDIR/dns-3.txt" 2>/dev/null &
}

# --- WAN flap detection ---

check_wan_flap() {
    local label="$1" uptime_raw="$2"
    [[ "$uptime_raw" == "—" || -z "$uptime_raw" ]] && return

    local state_file="$STATE_DIR/${label// /_}_wan_uptime"
    local prev_hours=0
    [[ -f "$state_file" ]] && prev_hours=$(cat "$state_file")

    # uptime_raw is HH:MM:SS from DrayTek
    local cur_hours
    cur_hours=$(echo "$uptime_raw" | cut -d: -f1)
    [[ -z "$cur_hours" || "$cur_hours" == "—" ]] && return

    if (( prev_hours > 0 && cur_hours < prev_hours )); then
        local prev_fmt cur_fmt
        prev_fmt=$(format_uptime "${prev_hours}:00:00")
        cur_fmt=$(format_uptime "${cur_hours}:00:00")
        add_issue "${YEL}${label}: WAN reconnected (was ${prev_fmt}, now ${cur_fmt})${RST}"
        echo "${label}|$(date '+%Y-%m-%d %H:%M')|${prev_fmt} -> ${cur_fmt}" >> "$STATE_DIR/flap_log"
    fi

    echo "$cur_hours" > "$state_file"
}

show_flap_log() {
    local logfile="$STATE_DIR/flap_log"
    [[ -f "$logfile" ]] || return
    local count
    count=$(wc -l < "$logfile")
    (( count == 0 )) && return

    echo ""
    printf "%bWAN Flap History%b %b(last 10)%b\n" "$BOLD" "$RST" "$DIM" "$RST"
    tail -10 "$logfile" | while IFS='|' read -r lbl when detail; do
        printf "  %b%s%b  %s  %s\n" "$DIM" "$when" "$RST" "$lbl" "$detail"
    done
}

# --- client list ---

show_clients() {
    echo ""
    printf "%bConnected Clients%b %b(.2 ARP table)%b\n" "$BOLD" "$RST" "$DIM" "$RST"

    local raw arp
    raw=$(telnet_cmds "192.168.1.2" "$R2_USER" "$R2_PASS" "ip arp status") || { echo "  (telnet failed)"; return; }
    arp=$(echo "$raw" | sed -n '/^=== ip arp status ===/,${//!p}') || true

    local has_clients=false
    {
        printf "IP\tMAC\tHostname\n"
        echo "$arp" | grep -P '^\s+\d+\s+192\.168\.' | while read -r _idx ip mac host _rest; do
            has_clients=true
            [[ -z "$host" ]] && host="—"
            printf "%s\t%s\t%s\n" "$ip" "$mac" "$host"
        done
    } | column -t -s$'\t'
}

# --- speed test ---

SPEED_BIND_IPS=(192.168.1.211 192.168.1.212 192.168.1.213)
SPEED_URL="http://speedtest3.vtn.com.vn/speedtest/random4000x4000.jpg"

speed_test_one() {
    local label="$1" bind_ip="$2"
    local bytes time_total speed
    bytes=$(curl --silent --max-time 15 --interface "$bind_ip" \
        -o /dev/null -w '%{size_download} %{time_total}' \
        "$SPEED_URL" 2>/dev/null) || bytes="0 0"
    local size=${bytes%% *}
    time_total=${bytes##* }

    if (( size > 0 )) && [[ "$time_total" != "0.000000" && "$time_total" != "0" ]]; then
        speed=$(echo "scale=1; $size * 8 / $time_total / 1000000" | bc)
        printf "%s\t%s Mbps\n" "$label" "$speed"
    else
        printf "%s\tfailed\n" "$label"
    fi
}

speed_has_bind_ips() {
    ip addr show dev eno2 2>/dev/null | grep -q "${SPEED_BIND_IPS[0]}"
}

start_speed_bg() {
    speed_has_bind_ips || return 0
    speed_test_one ".1" "${SPEED_BIND_IPS[0]}" > "$TMPDIR/speed-1.txt" 2>/dev/null &
    speed_test_one ".2" "${SPEED_BIND_IPS[1]}" > "$TMPDIR/speed-2.txt" 2>/dev/null &
    speed_test_one ".3" "${SPEED_BIND_IPS[2]}" > "$TMPDIR/speed-3.txt" 2>/dev/null &
}

show_probes() {
    if ! speed_has_bind_ips; then
        printf "\n%bprobes: run 'sudo =router-status --setup' first%b\n" "$DIM" "$RST"
        return
    fi
    wait
    echo ""

    local has_speed=false
    [[ -s "$TMPDIR/speed-1.txt" ]] && has_speed=true

    {
        if $has_speed; then
            printf "Router\tDNS\tDown\n"
        else
            printf "Router\tDNS\n"
        fi
        for i in 1 2 3; do
            local dns speed
            dns=$(cut -d$'\t' -f2 "$TMPDIR/dns-${i}.txt" 2>/dev/null) || dns="—"
            if $has_speed; then
                speed=$(cut -d$'\t' -f2 "$TMPDIR/speed-${i}.txt" 2>/dev/null) || speed="—"
                printf ".%s\t%s\t%s\n" "$i" "$dns" "$speed"
            else
                printf ".%s\t%s\n" "$i" "$dns"
            fi
        done
    } | column -t -s$'\t'
}

log_main_jsonl() {
    local r1_line="$1" r2_line="$2" r3_line="$3"
    mkdir -p "$(dirname "$MAIN_LOG_FILE")"

    local dns1 dns2 dns3 speed1 speed2 speed3 issue_count
    dns1=$(cut -d$'\t' -f2 "$TMPDIR/dns-1.txt" 2>/dev/null) || dns1="—"
    dns2=$(cut -d$'\t' -f2 "$TMPDIR/dns-2.txt" 2>/dev/null) || dns2="—"
    dns3=$(cut -d$'\t' -f2 "$TMPDIR/dns-3.txt" 2>/dev/null) || dns3="—"
    speed1=$(cut -d$'\t' -f2 "$TMPDIR/speed-1.txt" 2>/dev/null) || speed1="—"
    speed2=$(cut -d$'\t' -f2 "$TMPDIR/speed-2.txt" 2>/dev/null) || speed2="—"
    speed3=$(cut -d$'\t' -f2 "$TMPDIR/speed-3.txt" 2>/dev/null) || speed3="—"
    issue_count=0
    [[ -s "$ISSUES_FILE" ]] && issue_count=$(wc -l < "$ISSUES_FILE")

    jq -nc \
        --arg ts "$(date -Iseconds)" \
        --arg r1 "$r1_line" --arg r2 "$r2_line" --arg r3 "$r3_line" \
        --arg dns1 "$dns1" --arg dns2 "$dns2" --arg dns3 "$dns3" \
        --arg speed1 "$speed1" --arg speed2 "$speed2" --arg speed3 "$speed3" \
        --argjson issues "$issue_count" \
        '
        def router_fields:
          split("\t") as $f |
          {
            wan: $f[1],
            v4: $f[3],
            v6: $f[4],
            sessions: ($f[5] | split("/")[0] | tonumber? // null),
            clients: ($f[6] | tonumber? // null)
          };
        def ms_val: if test("^[0-9]+ms$") then (rtrimstr("ms") | tonumber) else null end;
        def mbps_val: if test(" Mbps$") then (rtrimstr(" Mbps") | tonumber) else null end;
        {
          ts: $ts,
          issues: $issues,
          r1: (($r1 | router_fields) + {dns_ms: ($dns1 | ms_val), speed_mbps: ($speed1 | mbps_val)}),
          r2: (($r2 | router_fields) + {dns_ms: ($dns2 | ms_val), speed_mbps: ($speed2 | mbps_val)}),
          r3: (($r3 | router_fields) + {dns_ms: ($dns3 | ms_val), speed_mbps: ($speed3 | mbps_val)})
        }
        ' >> "$MAIN_LOG_FILE" 2>/dev/null || true
}

# --- setup/teardown for secondary IPs ---

HOST_IF="eno2"
SETUP_BIND_IPS=(192.168.1.211 192.168.1.212 192.168.1.213)
SETUP_GATEWAYS=(192.168.1.1 192.168.1.2 192.168.1.3)
SETUP_TABLES=(211 212 213)

do_setup() {
    for i in 0 1 2; do
        local idx=$((i + 1)) ip="${SETUP_BIND_IPS[$i]}" gw="${SETUP_GATEWAYS[$i]}" table="${SETUP_TABLES[$i]}"
        ip addr show dev "$HOST_IF" | grep -q "$ip" || ip addr add "${ip}/24" dev "$HOST_IF"
        grep -q "^${table} " /etc/iproute2/rt_tables 2>/dev/null || echo "${table} via_gw${idx}" >> /etc/iproute2/rt_tables
        ip route replace default via "$gw" dev "$HOST_IF" table "$table"
        ip route replace 192.168.1.0/24 dev "$HOST_IF" scope link table "$table" 2>/dev/null || true
        ip rule del from "$ip" 2>/dev/null || true
        ip rule add from "$ip" table "$table"
        echo ".${idx}: ${ip} -> ${gw}"
    done
    echo ""
    echo "verifying..."
    for i in 0 1 2; do
        local idx=$((i + 1)) ip="${SETUP_BIND_IPS[$i]}" pub
        pub=$(curl --silent --max-time 5 --interface "$ip" "http://ifconfig.me" 2>/dev/null) || pub="FAIL"
        echo "  .${idx} (${ip}): public=${pub}"
    done
}

do_teardown() {
    for i in 0 1 2; do
        ip addr del "${SETUP_BIND_IPS[$i]}/24" dev "$HOST_IF" 2>/dev/null || true
        ip rule del from "${SETUP_BIND_IPS[$i]}" 2>/dev/null || true
        ip route del default table "${SETUP_TABLES[$i]}" 2>/dev/null || true
        ip route del 192.168.1.0/24 table "${SETUP_TABLES[$i]}" 2>/dev/null || true
    done
    sed -i '/via_gw[123]/d' /etc/iproute2/rt_tables 2>/dev/null || true
    echo "secondary IPs and routes removed"
}

# --- wifi (UniFi Site Manager, via a real browser session) ---

log_wifi_jsonl() {
    mkdir -p "$(dirname "$WIFI_LOG_FILE")"
    jq -nc \
        --arg ts "$(date -Iseconds)" \
        --argjson ok "$1" \
        --argjson isp_quality "${2:-null}" \
        --argjson total_wifi "${3:-null}" \
        --argjson degraded "${4:-null}" \
        --argjson notable "${5:-null}" \
        '{ts: $ts, ok: $ok, isp_quality: $isp_quality, total_wifi: $total_wifi, degraded: $degraded, notable: $notable}' \
        >> "$WIFI_LOG_FILE"
}

do_wifi() {
    wifi_start_time=$SECONDS
    wifi_tmp=""
    # registered up front so every exit path — including the early checks below —
    # reports timing and cleans up, not just the ones after setup succeeds
    trap '[[ -n "$wifi_tmp" ]] && rm -rf "$wifi_tmp"; "$RODNEY" stop > /dev/null 2>&1 || true; printf "%bfinished in %ds%b\n" "$DIM" "$((SECONDS - wifi_start_time))" "$RST"' EXIT

    command -v "$RODNEY" > /dev/null || { echo "rodney not found at $RODNEY" >&2; exit 1; }
    [[ -x "$CHROME_COOKIES" ]] || { echo "chrome-cookies-linux not found at $CHROME_COOKIES" >&2; exit 1; }

    # isolated rodney profile so this never collides with an ad-hoc `rodney`
    # session (shared ~/.rodney chrome profile can't be used by two processes at once)
    export RODNEY_HOME="$HOME/.local/state/router-status-wifi/rodney"
    mkdir -p "$RODNEY_HOME"

    wifi_tmp=$(mktemp -d)
    local cookiefile="$wifi_tmp/cookies.txt"

    "$CHROME_COOKIES" ui.com > "$cookiefile"
    chmod 600 "$cookiefile"
    [[ -s "$cookiefile" ]] || { echo "no ui.com cookies in Chrome — log into unifi.ui.com in Chrome first" >&2; exit 1; }

    "$RODNEY" start > /dev/null 2>&1 || true
    # NOTE: rodney's `cookies set` only takes name/value as CLI args, no stdin or
    # file-based import exists, so the live auth cookie (UBIC_AUTH, ~30d bearer
    # credential) is briefly visible via ps/procfs to any other local user for
    # the life of each short-lived call. Accepted risk on a single-user machine;
    # revisit if this ever runs somewhere that isn't.
    while IFS=$'\t' read -r domain _flag path secure _expiry name value; do
        domain="${domain#\#HttpOnly_}"
        local secure_flag=()
        [[ "$secure" == "TRUE" ]] && secure_flag=(--secure)
        "$RODNEY" cookies set "$name" "$value" --domain "$domain" --path "$path" "${secure_flag[@]}" --httponly > /dev/null 2>&1 || true
    done < "$cookiefile"
    rm -f "$cookiefile"

    [[ -t 1 ]] && printf "%bloading wifi data...%b\r" "$DIM" "$RST"

    "$RODNEY" open "https://unifi.ui.com/consoles/${UNIFI_CONSOLE_ID}/network/default/dashboard" > /dev/null 2>&1 || true
    sleep 3
    "$RODNEY" waitidle > /dev/null 2>&1 || true
    local wan_json
    wan_json=$("$RODNEY" js "$(cat "$WIFI_EXTRACT_WAN")" 2>/dev/null) || wan_json='{}'
    echo "$wan_json" | jq empty 2>/dev/null || wan_json='{}'

    "$RODNEY" open "https://unifi.ui.com/consoles/${UNIFI_CONSOLE_ID}/network/default/clients/active" > /dev/null 2>&1 || true
    sleep 4
    "$RODNEY" waitidle > /dev/null 2>&1 || true
    local clients_json
    clients_json=$("$RODNEY" js "$(cat "$WIFI_EXTRACT_CLIENTS")" 2>/dev/null) || clients_json='[]'
    echo "$clients_json" | jq empty 2>/dev/null || clients_json='[]'

    [[ -t 1 ]] && printf "              \r"

    echo ""
    printf "%bWiFi Status%b  %b%s%b\n" "$BOLD" "$RST" "$DIM" "$(date '+%Y-%m-%d %H:%M:%S')" "$RST"
    echo ""

    local uptime monthly_usage isp_name
    uptime=$(echo "$wan_json" | jq -r '.uptime // "—"')
    monthly_usage=$(echo "$wan_json" | jq -r '.monthlyUsage // "—"')
    isp_name=$(echo "$wan_json" | jq -r '.ispName // "—"')
    printf "Console: %bUDM SE - HCMC Tam Dao%b (%s)\n" "$BOLD" "$RST" "$isp_name"
    printf "Uptime: %s\n" "$uptime"
    printf "Usage this month: %s\n" "$monthly_usage"

    local isp_quality
    isp_quality=$(echo "$wan_json" | jq -r '.ispQuality // empty')
    if [[ -n "$isp_quality" ]] && (( isp_quality < 90 )); then
        echo ""
        printf "%b%bISP quality low: %s%%%b\n" "$BOLD" "$YEL" "$isp_quality" "$RST"
    fi

    local raw_count
    raw_count=$(echo "$clients_json" | jq -r 'length')

    if (( raw_count == 0 )); then
        echo ""
        printf "%b%bextraction failed — got 0 clients back (session/page load issue, not an empty network). try again.%b\n" "$BOLD" "$RED" "$RST"
        echo ""
        log_wifi_jsonl false
        return 0
    fi

    local notable_json total_count degraded_count shown_count
    notable_json=$(echo "$clients_json" | jq -f "$WIFI_NOTABLE_FILTER")
    total_count=$(echo "$notable_json" | jq -r '.total')
    degraded_count=$(echo "$notable_json" | jq -r '.degraded')
    shown_count=$(echo "$notable_json" | jq -r '.shown')

    log_wifi_jsonl true "${isp_quality:-null}" "$total_count" "$degraded_count" "$shown_count"

    echo ""
    printf "%bAccess Points%b\n" "$BOLD" "$RST"
    echo "$clients_json" | jq -r '[.[] | select(.ap != "" and .ap != "WireGuard")] | group_by(.ap) | map({ap: .[0].ap, clients: length}) | sort_by(-.clients) | .[] | "\(.ap)\t\(.clients)"' \
        | { printf "AP\tClients\n"; cat; } | column -t -s$'\t'

    echo ""
    printf "%bClients%b %b(%s wifi, %s not Excellent, showing %s notable)%b\n" "$BOLD" "$RST" "$DIM" "$total_count" "$degraded_count" "$shown_count" "$RST"
    {
        printf "Name\tAP\tExp\tTech\tCh\tDL\n"
        echo "$notable_json" | jq -r '
            .clients[] |
            "\(.name[0:22])\t\((.ap // "—")[0:14])\t\(.experience // "—")\t\(
                (.tech // "—") | gsub("WiFi "; "W") | gsub(", "; " ")
            )\t\(
                (.channel // "—") | gsub(" "; " ") | gsub(" \\("; "/") | gsub(" GHz, "; "G/") | gsub(" MHz\\)"; "M")
            )\t\(.download // "—")"'
    } | column -t -s$'\t'
    echo ""
}

# --- main ---

case "${1:-}" in
    --setup)    do_setup; exit 0 ;;
    --teardown) do_teardown; exit 0 ;;
    --watch)    python3 "$WATCH_HELPER" "${2:-30s}"; exit 0 ;;
    wifi)       do_wifi; exit 0 ;;
esac

NO_SPEED=false
VERBOSE=false
for arg in "$@"; do
    case "$arg" in
        --no-speed) NO_SPEED=true ;;
        --verbose|-v) VERBOSE=true ;;
    esac
done

echo ""
printf "%bRouter Status%b  %b%s%b\n" "$BOLD" "$RST" "$DIM" "$(date '+%Y-%m-%d %H:%M:%S')" "$RST"
echo ""

# kick off background jobs
$NO_SPEED || start_speed_bg
start_dns_bg

[[ -t 1 ]] && printf "%bcollecting...%b\r" "$DIM" "$RST"

r1=$(collect_draytek "192.168.1.1" ".1 (FPT)" "$R1_USER" "$R1_PASS" 2>/dev/null) \
    || r1=$(printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" ".1 (FPT)" "ERR" "—" "—" "—" "—" "—" "—" "telnet failed")
r2=$(collect_draytek "192.168.1.2" ".2 (VNPT)" "$R2_USER" "$R2_PASS" 2>/dev/null) \
    || r2=$(printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" ".2 (VNPT)" "ERR" "—" "—" "—" "—" "—" "—" "telnet failed")
r3=$(collect_ont 2>/dev/null) \
    || r3=$(printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" ".3 (Viettel)" "ERR" "—" "—" "—" "—" "—" "—" "curl failed")

[[ -t 1 ]] && printf "              \r"

# WAN flap detection using raw uptimes saved by collect_draytek
check_wan_flap ".1" "$(cat "$TMPDIR/uptime-1" 2>/dev/null || echo "—")" 2>/dev/null || true
check_wan_flap ".2" "$(cat "$TMPDIR/uptime-2" 2>/dev/null || echo "—")" 2>/dev/null || true

if [[ -s "$ISSUES_FILE" ]]; then
    printf "%b%bIssues%b\n" "$BOLD" "$RED" "$RST"
    while IFS= read -r issue; do
        printf "  %b\n" "$issue"
    done < "$ISSUES_FILE"
    echo ""
fi

{
    printf "Router\tWAN\tIP\tv4\tv6\tSessions\tClnt\tUptime\tTX / RX\n"
    echo "$r1"
    echo "$r2"
    echo "$r3"
} | column -t -s$'\t'

show_probes || true

log_main_jsonl "$r1" "$r2" "$r3"

if $VERBOSE; then
    show_flap_log || true
    show_clients || true
fi

echo ""

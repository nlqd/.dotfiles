#!/usr/bin/env bash

# require: fzf jq nvim node
# require(custom): richify

set -o pipefail
shopt -s nullglob

BASE_URL="https://admin.skydeck.ai/api/v1"
CACHE_FILE="/tmp/sdai-cache.txt"
CACHE_TIMEOUT=300 # 5 minutes

COOKIE_FILE="$HOME/.sdai/cookies"
HEADER_REFERER="Referer: https://eastagile.skydeck.ai/"

BG='\e[1;32m'
CLR='\e[0m'

declare -A MODELS

MODELS["cld-5-fable"]=9484
MODELS["cld-5-opus"]=9846
MODELS["cld-5-sonnet"]=9535
MODELS["cld-45-haiku"]=7640
MODELS["gem-31-pro"]=8545
MODELS["gem-36-flash"]=9784
MODELS["gpt-56-terra"]=9699
MODELS["gpt-56-luna"]=9631
MODELS["gpt-6-astra"]=9956
MODELS["gpt-oss"]=7357

# global context
STREAMING="false"
CONVERSATION_ID=""
ASSI_MESSAGE_ID=""
MODEL_NAME=""
MODEL_ID=""
MESSAGE=""

QUERY_FILE() {
  echo "/tmp/sdai-query-${CONVERSATION_ID:-new}.md"
}
RESPONSE_FILE() {
  echo "/tmp/sdai-conv-${CONVERSATION_ID:-new}.md"
}
OUTPUT_FILE() {
  echo "/tmp/sdai-agent-output-${CONVERSATION_ID:-new}.txt"
}

###
# LOCAL OPS
###

dash() {
  printf "${BG}----------${CLR}\n"
}

abort() {
  echo "$1" && exit 1
}

richify_or_cat() {
  command -v richify >/dev/null && richify || cat
}

pick_model() {
  local selected
  selected=$(
    ([[ -z $1 ]] &&
      (for key in "${!MODELS[@]}"; do echo "$key"; done | fzf --prompt="Select a model: ")) ||
      (for key in "${!MODELS[@]}"; do echo "$key"; done | fzf --filter "$1" | head -n 1)
  )
  [[ -z "$selected" ]] && echo "Model selection cancelled" && return
  set_model "$selected"
}

set_model() {
  MODEL_NAME=$1 && MODEL_ID=${MODELS[$1]}
}

invalidate_cache() {
  [[ -f "$CACHE_FILE" ]] && rm $CACHE_FILE
}

get_access_token() {
  grep "_access" "$COOKIE_FILE" | cut -f7
}

###
# NETWORK CALLS
###

refresh() {
  local exp
  exp=$(get_access_token | node -e 'let t="";process.stdin.on("data",d=>t+=d).on("end",()=>console.log(JSON.parse(Buffer.from(t.split(".")[1],"base64url")).exp))')

  [[ "$(date +%s)" -gt "$exp" ]] &&
    curl -s -X POST -o /dev/null "$BASE_URL/authentication/token/refresh/" \
      -H "$HEADER_REFERER" --cookie "$COOKIE_FILE" --cookie-jar "$COOKIE_FILE"
}

call() {
  refresh
  curl -s --cookie "$COOKIE_FILE" -H "Content-Type: application/json" -H "$HEADER_REFERER" "$@"
}

call_form() {
  refresh
  curl -s --cookie "$COOKIE_FILE" -H "Content-Type: multipart/form-data" -H "$HEADER_REFERER" "$@"
}

delete_conversation() {
  call "$BASE_URL/conversations/${1:-$CONVERSATION_ID}" -o /dev/null -X DELETE &
}

post_user_message() {
  # {"top_k":40,"top_p":1,"max_tokens":64000,"temperature":1}
  # -F "user_model_parameters=$(jq --null-input --argjson temperature 0.1 '{temperature}')" \
  echo "$MESSAGE" > $(OUTPUT_FILE)
  call_form "$BASE_URL/conversations/chat_v2/" -F "message=<$(OUTPUT_FILE)" \
    -F "model_id=$MODEL_ID" -F "conversation_id=$CONVERSATION_ID" -F "regenerate_message_id=-1" \
    -F 'user_model_parameters={"prompt_caching":true,"thinking":{"type":"enabled","budget_tokens":16000},"max_tokens":64000,"temperature":0.17}' \
    -F 'behavior_settings={"markdown_view":true,"latex_view":false,"explicit_url_detection":false,"function_call_aggressiveness":0,"commentary_enabled":false}' \
    -F 'local_mcp_server_id=4331da01-91fb-414e-9a94-8671425989d0'
}

# chunk can be part of json, one json, or mutliple json
parse_response_stream() {
  node -e "process.stdin.on('data', data => process.stdout.write(
    JSON.parse('[' + data.toString().replaceAll('}{', '},{') + ']')
        .map(d => d.chunks || '').join(''))
  )"
}

get_response_stream() {
  STREAMING="true"
  call "$BASE_URL/conversations/streaming/" --data '{"message_id": '"$ASSI_MESSAGE_ID"' }' --no-buffer |
    parse_response_stream |
    tee $(RESPONSE_FILE) |
    richify_or_cat

  STREAMING="false"
}

stop_response_stream() {
  [ "$STREAMING" == "false" ] && return

  call "$BASE_URL/conversations/messages/$ASSI_MESSAGE_ID/stop-streaming/" -o /dev/null -d "{}"
  echo -e "${BG}Interrupted${CLR}"
}

get_conversations() {
  [[ ! -f $CACHE_FILE ]] && call "$BASE_URL/conversations/?sort_by=created" | tee "$CACHE_FILE"

  local cur
  cur=$(date +%s)
  local mod
  mod=$( ([[ $(uname) = 'Linux' ]] && stat --format=%Y $CACHE_FILE) || stat -f %m $CACHE_FILE)
  if [[ $((cur - mod)) -lt $CACHE_TIMEOUT ]]; then
    cat "$CACHE_FILE"
  else
    call "$BASE_URL/conversations/?sort_by=created" | tee "$CACHE_FILE"
  fi
}

pick_conversation_id() {
  get_conversations | jq -c '.results[] | { id, name, size }' | fzf | jq '.id'
}

pick_conversation_ids() {
  get_conversations | jq -c '.results[] | { id, name, size }' | fzf -m | jq '.id'
}

get_conversation_history() {
  local res
  res=$(call "$BASE_URL/conversations/$CONVERSATION_ID")

  MODEL_ID=$(jq '.data.messages[-1].model' <<<"$res")
  for name in "${!MODELS[@]}"; do
    if [[ ${MODELS["$name"]} = $MODEL_ID ]]; then
      MODEL_NAME="$name"
      break
    fi
  done

  jq -r "[.data.messages[].content] | join(\"\\n$(dash)\\n\")" <<<"$res"
}

get_pods() {
  call "$BASE_URL/pods/instances/"
}

pick_pod_id() {
  local selected
  selected=$(
    ([[ -z $1 ]] &&
      (get_pods | jq -c '.results[] | { id, name, status }' | fzf --prompt="Select a pod: ")) ||
      (get_pods | jq -c '.results[] | { id, name, status }' | fzf --filter "$1" | head -n 1)
  )
  [[ -z "$selected" ]] && return
  jq -r '.id' <<<"$selected"
}

###
# MAIN OPS
###

setup_mesh() {
  local name="$1" member_ids
  member_ids=$(get_pods | jq -c '[.results[] | select(.is_owner or .can_manage) | .id]')
  [[ "$(jq 'length' <<<"$member_ids")" -lt 2 ]] && return
  call "$BASE_URL/pods/meshes/" -X POST -d "$(jq -c --arg name "$name" '{name: $name, member_ids: .}' <<<"$member_ids")" |
    jq -r '.id // empty'
}

teardown_mesh() {
  [[ -z "$1" ]] && return
  call "$BASE_URL/pods/meshes/$1/" -X DELETE -o /dev/null
}

close_terminal() {
  [[ -z "$2" ]] && return
  call "$BASE_URL/pods/instances/$1/terminals/$2/" -X DELETE -o /dev/null
}

# Most recent terminal nobody's currently attached to (empty driver_name), if any -
# reattaching to a live-but-detached session beats always spawning a fresh one.
pick_existing_terminal() {
  call "$BASE_URL/pods/instances/$1/terminals/" |
    jq -r '[.results[] | select(.driver_name == "")] | sort_by(.created_at) | last | .id // empty'
}

teardown_mesh_bg() {
  local pid="$1" id_file="$2"
  wait "$pid" 2>/dev/null
  teardown_mesh "$(cat "$id_file" 2>/dev/null)"
  rm -f "$id_file"
}

pod_shell() {
  local pod_id term_json term_id attach_json token ws_url cookie mesh_pid mesh_id_file

  pod_id=$(pick_pod_id "$1")
  [[ -z "$pod_id" ]] && abort "No pod selected"

  mesh_id_file=$(mktemp)
  setup_mesh "sdai-auto-$$" >"$mesh_id_file" &
  mesh_pid=$!
  trap "teardown_mesh_bg '$mesh_pid' '$mesh_id_file'" EXIT

  term_id=$(pick_existing_terminal "$pod_id")
  if [[ -z "$term_id" ]]; then
    term_json=$(call -X POST -d '{}' "$BASE_URL/pods/instances/$pod_id/terminals/")
    term_id=$(jq -r '.session.id // empty' <<<"$term_json")
    [[ -z "$term_id" ]] && abort "Failed to create terminal: $term_json"
  fi
  trap "close_terminal '$pod_id' '$term_id'; teardown_mesh_bg '$mesh_pid' '$mesh_id_file'" EXIT

  attach_json=$(call -X POST -d '{"role":"driver"}' "$BASE_URL/pods/instances/$pod_id/terminals/$term_id/attach/")
  token=$(jq -r '.token // empty' <<<"$attach_json")
  ws_url=$(jq -r '.ws_url // empty' <<<"$attach_json")
  [[ -z "$token" ]] && abort "Failed to attach: $attach_json"

  cookie=$(get_access_token)
  [[ -z "$cookie" ]] && abort "No access token — refresh cookies"

  echo -e "${BG}Connected — Ctrl-] to detach${CLR}"
  SDAI_WS_URL="$ws_url" SDAI_TOKEN="$token" SDAI_COOKIE="$cookie" \
    node -e '
function frame(opcode, payload) {
  const len = payload.length;
  return Buffer.concat([Buffer.from(len < 126 ? [0x80 | opcode, 0x80 | len, 0, 0, 0, 0] : [0x80 | opcode, 0xfe, len >> 8, len & 0xff, 0, 0, 0, 0]), payload]);
}
function parseFrame(buf) {
  if (buf.length < 2) return null;
  let len = buf[1] & 0x7f, off = 2;
  if (len === 126) { if (buf.length < 4) return null; len = buf.readUInt16BE(2); off = 4; }
  else if (len === 127) { if (buf.length < 10) return null; len = Number(buf.readBigUInt64BE(2)); off = 10; }
  if (buf.length < off + len) return null;
  return { opcode: buf[0] & 0x0f, payload: buf.subarray(off, off + len), rest: buf.subarray(off + len) };
}
function splitOnDetach(chunk) {
  const i = chunk.indexOf(0x1d);
  return i === -1 ? { before: chunk, detach: false } : { before: chunk.subarray(0, i), detach: true };
}
const { SDAI_WS_URL, SDAI_TOKEN, SDAI_COOKIE } = process.env;
require("https").get({
  hostname: "admin.skydeck.ai", path: `${SDAI_WS_URL}?token=${encodeURIComponent(SDAI_TOKEN)}`,
  headers: { Connection: "Upgrade", Upgrade: "websocket", "Sec-WebSocket-Version": "13", "Sec-WebSocket-Key": "AAAAAAAAAAAAAAAAAAAAAA==", Origin: "https://eastagile.skydeck.ai", Cookie: `eastagile_access=${SDAI_COOKIE}` },
}, (r) => { console.error(`sdai pod: HTTP ${r.statusCode}`); process.exit(1); })
  .on("error", (e) => { console.error(`sdai pod: ${e.message}`); process.exit(1); })
  .on("upgrade", (_res, socket, head) => {
    let buf = head && head.length ? Buffer.from(head) : Buffer.alloc(0), resized = false;
    const send = (obj) => socket.write(frame(0x1, Buffer.from(JSON.stringify(obj))));
    const resize = () => process.stdout.isTTY && send({ type: "resize", cols: process.stdout.columns, rows: process.stdout.rows });
    const pump = () => {
      let f;
      while ((f = parseFrame(buf))) {
        buf = f.rest;
        if (f.opcode === 0x8) { socket.end(); process.exit(0); }
        if (f.opcode === 0x9) { socket.write(frame(0xa, f.payload)); continue; }
        if (f.opcode !== 0x1) continue;
        const msg = JSON.parse(f.payload.toString());
        if (msg.type !== "output") continue;
        process.stdout.write(msg.data);
        if (!resized) { resized = true; resize(); }
      }
    }

    socket.on("data", (chunk) => { buf = Buffer.concat([buf, chunk]); pump(); }).on("close", () => process.exit(0)).on("error", (e) => { console.error(`\r\n[connection error: ${e.message}]`); process.exit(1); });
    process.stdout.on("resize", resize);
    if (process.stdin.isTTY) process.stdin.setRawMode(true);
    process.stdin.on("data", (chunk) => {
      const { before, detach } = splitOnDetach(chunk);
      if (before.length) send({ type: "input", data: before.toString() });
      if (!detach) return;
      process.stderr.write("\r\n[detached]\r\n");
      socket.end(frame(0x8, Buffer.alloc(0)));
      process.exit(42); //
    });

    pump();
  });
'
  # exit 42 = detached (Ctrl-])
  [[ $? -eq 42 ]] && trap "teardown_mesh_bg '$mesh_pid' '$mesh_id_file'" EXIT
}

start_chat_session() {
  echo -e "${BG}${MODEL_NAME}${CLR}"

  while true; do
    dash

    read -e -r MESSAGE || return

    if [[ -z "$MESSAGE" ]]; then
      # or: https://github.com/jake-stewart/inline
      nvim $(QUERY_FILE)
      MESSAGE=$(cat $(QUERY_FILE))
    fi

    # shell execute
    if [[ "$MESSAGE" =~ ^/! ]]; then
      eval "${MESSAGE#/! }"
      continue
    fi

    # model
    if [[ "$MESSAGE" =~ ^/m ]]; then
      read -r _ model <<<"$MESSAGE"
      pick_model "$model"
      echo -e "${BG}${MODEL_NAME}${CLR}"
      continue
    fi

    # yank
    if [[ "$MESSAGE" =~ ^/y ]]; then
      read -r _ block <<<"$MESSAGE"
      if [[ -z "$block" ]]; then
        cat $(RESPONSE_FILE)
      else
        cat $(RESPONSE_FILE) | sed -n '/^```'"$block"'.*$/,/^```$/p' | sed '/^```/d'
      fi | {
        ([[ $(uname) = 'Darwin' ]] && pbcopy) || xclip -sel c
      }
      continue
    fi

    if [[ "$MESSAGE" = "/colab" ]]; then
      call "$BASE_URL/conversations/collaboration/stop" --data '{"conversation_id":'"$CONVERSATION_ID"'}' >/dev/null
      echo "https://eastagile.skydeck.ai/conversation/$(
        call "$BASE_URL/conversations/collaboration/start" --data '{"conversation_id":'"$CONVERSATION_ID"'}' |
          jq -r '.data.collaboration_slug'
      )"
      continue
    fi

    if [[ "$MESSAGE" = "/snap" ]]; then
      call "$BASE_URL/conversations/$CONVERSATION_ID/create_snapshot" --data '{"anonymize":"false"}' | jq -r '.url'
      continue
    fi

    if [[ "$MESSAGE" = "/clear" ]]; then
      clear
      continue
    fi

    if [[ "$MESSAGE" =~ ^/ ]]; then
      echo "No matching slash command"
      continue
    fi

    dash
    send_and_recv_cancellable

    printf "\n${BG}%s${CLR}\n" "$(call "$BASE_URL/conversations/$CONVERSATION_ID/cost" |
      jq -r '.conversation_total_usage_cost')"
  done
}

send_and_recv_cancellable() {
  local response
  response="$(post_user_message)"

  if [[ $? ]]; then
    read -r CONVERSATION_ID ASSI_MESSAGE_ID < <(
      jq -r '[.data.conversation_id, .data.messages[-1].id] | join(" ")' <<<"$response"
    )
    trap stop_response_stream SIGINT
    get_response_stream
    trap - SIGINT
  else
    echo "$response"
  fi
}

main() {
  [[ "$#" -lt 1 ]] &&
    abort "Usage: sdai [chat | pick-chat | resume | delete | query-models | pod]"

  pick_model "$([ -t 0 ] && echo "opus" || echo "haiku")"

  case "$1" in
  c | chat)
    start_chat_session
    ;;
  pc | pick-chat)
    pick_model
    start_chat_session
    ;;
  r | resume)
    CONVERSATION_ID=$(pick_conversation_id) || abort "No conversation selected"
    get_conversation_history | richify_or_cat
    start_chat_session
    ;;
  d | delete)
    for id in $(pick_conversation_ids); do
      delete_conversation "$id"
    done
    invalidate_cache
    ;;
  query-models)
    call "$BASE_URL/models/" |
      jq -r '.[] | [ .id, .name, .context_window ] | @tsv' | column -t -s $'\t' | sort -u -k2
    ;;
  pod)
    pod_shell "$2"
    ;;
  *)
    abort "Unknown command: $1"
    ;;
  esac
}

main "$@"

#!/usr/bin/env bash

# require: cliphist wl-paste

# wl-clip-watch - keep the clipboard history watchers running, one for text and one for images.
# Starts only the ones that are not running, so it is safe to run at login and again by hand.
# Copies that the source marks as secret are skipped by cliphist itself (CLIPBOARD_STATE=sensitive).

command -v cliphist >/dev/null || exit 0

for type in text image; do
  pgrep --full --exact -- "wl-paste --type $type --watch cliphist store" >/dev/null && continue
  setsid wl-paste --type "$type" --watch cliphist store </dev/null >/dev/null 2>&1 &
done

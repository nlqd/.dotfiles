#!/usr/bin/env bash
# zoom-earth-wallpaper - snapshot the zoom.earth precipitation map as wallpaper
#
# Headless-screenshots the current view via rodney (no date= param, so it
# always loads "now"), hides zoom.earth's own UI chrome by targeting the
# map's DOM structure (everything under <main> except the map <section>),
# then points feh at the result.
set -euo pipefail

URL='https://zoom.earth/maps/precipitation/#view=12.5,65,4z/model=icon'
OUT="$HOME/Downloads/wallpapers/zoom-earth-precipitation.png"
FEHBG="$HOME/.fehbg"
WIDTH=3840
HEIGHT=2160
LOCK="${XDG_RUNTIME_DIR:-/tmp}/zoom-earth-wallpaper.lock"

# Dedicated profile, isolated from rodney's shared ~/.rodney used by other
# projects - this script owns it outright and can freely reset it below.
export RODNEY_HOME="$HOME/.rodney-wallpaper"
PROFILE_DIR="$RODNEY_HOME/chrome-data"
PROFILE_MAX_MB=200

# Guard against a cron tick firing while the previous run is still going
# (e.g. a slow network); skip rather than stack a second Chrome on top.
exec 9>"$LOCK"
flock -n 9 || { echo "already running, skipping" >&2; exit 0; }

# Weeks of accumulated cache/IndexedDB/service-worker state in this profile
# has been observed to reliably crash Chrome mid-capture (confirmed: wiping
# a 614MB profile immediately fixed repeated EOF crashes). Reset it before
# it gets that far, since this script has no need for cross-run state.
if [[ -d "$PROFILE_DIR" ]]; then
  size_mb=$(du -sm "$PROFILE_DIR" 2>/dev/null | cut -f1)
  if [[ -n "$size_mb" && "$size_mb" -gt "$PROFILE_MAX_MB" ]]; then
    rm -rf "$PROFILE_DIR"
    echo "profile grew to ${size_mb}MB, reset" >&2
  fi
fi

STRIP_JS="(() => { Array.from(document.querySelectorAll('main > *')).forEach(el => { if (el.tagName !== 'SECTION') el.style.setProperty('display','none','important'); }); return true; })()"

TMP="$(mktemp --suffix=.png)"
trap 'rodney stop >/dev/null 2>&1 || true; rm -f "$TMP"' EXIT

capture() {
  rodney start >/dev/null
  rodney open "$URL" >/dev/null
  rodney waitload >/dev/null
  rodney waitidle >/dev/null

  # The 4K capture size only starts loading its own map/label tiles once we
  # actually request it (a throwaway capture triggers that). Those tile
  # fetches are slow to finish, well past what waitidle alone reports done -
  # give them a real 15s before the shot that counts, or the far corners of
  # the frame come out as a plain, low-detail placeholder.
  rodney screenshot -w "$WIDTH" -h "$HEIGHT" "$TMP" >/dev/null
  sleep 15
  rodney waitidle >/dev/null
  sleep 3

  # Hiding ~35 sibling elements changes the map section's computed layout,
  # which triggers the map library's own resize/redraw handling. Capturing
  # immediately after can catch that mid-reflow (a blank frame) or crash
  # Chrome outright - give it a moment to settle first.
  rodney js "$STRIP_JS" >/dev/null
  rodney waitidle >/dev/null
  sleep 2
  rodney screenshot -w "$WIDTH" -h "$HEIGHT" "$OUT" >/dev/null
}

# Chrome occasionally dies or drops the devtools connection mid-run (crash,
# transient resource pressure); tear it down fully and retry once with a
# fresh browser rather than letting one hiccup fail the whole cron tick.
attempt=1
max_attempts=2
until capture; do
  rodney stop >/dev/null 2>&1 || true
  # A crashed (not gracefully-stopped) Chrome leaves its Singleton lock
  # behind, which would otherwise wedge every future attempt - clean, not
  # just stop, before retrying.
  rm -f "$PROFILE_DIR"/Singleton{Lock,Cookie,Socket} 2>/dev/null || true
  (( attempt >= max_attempts )) && { echo "capture failed after $max_attempts attempts" >&2; exit 1; }
  echo "capture attempt $attempt failed, retrying with a fresh browser" >&2
  attempt=$((attempt + 1))
done

# Under Sway, set the background through it. Cron has no session environment, so look for the
# socket instead of relying on $SWAYSOCK. Sway's own config applies $OUT again after a reload.
set_in_sway() {
  command -v swaymsg >/dev/null || return 1
  local sock
  for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/sway-ipc.*.sock; do
    [ -S "$sock" ] && swaymsg --socket "$sock" output '*' bg "$OUT" fill >/dev/null 2>&1 && return 0
  done
  return 1
}

if ! set_in_sway; then
  feh --no-fehbg --bg-fill "$OUT"

  # Wire .fehbg once so restarts pick this up too; leave it alone afterwards
  # so re-running this script doesn't keep rewriting a file outside its job.
  if ! grep -qF "$OUT" "$FEHBG" 2>/dev/null; then
    sed -i -E "s|^(feh )|# \1|" "$FEHBG"
    printf "feh --no-fehbg --bg-fill '%s'\n" "$OUT" >> "$FEHBG"
  fi
fi

echo "wallpaper refreshed: $OUT"

plugins=(git systemd)

### envs
export ZSH="$HOME/.oh-my-zsh"

export KEYTIMEOUT=1

HISTSIZE=999999999
SAVEHIST=$HISTSIZE

# Agents paste long commands into tmux panes (base64 blobs, heredocs, curl payloads)
# and sometimes forget the leading space. 500 chars sits above the 99th percentile
# of this history (384); what's longer is almost all agent output. Return 2 keeps
# the line in this shell's history but never writes it to $HISTFILE.
autoload -Uz add-zsh-hook
_history_skip_long() { (( ${#1} <= 500 )) || return 2 }
add-zsh-hook zshaddhistory _history_skip_long

# PATH, EDITOR and DEV_HOME live in ~/.zshenv. Only interactive settings here.
export MANPAGER='nvim +Man!'
export FZF_DEFAULT_OPTS="--layout=reverse"

# `<tool> completion zsh` costs 20-30ms per tool at every startup. Cache each
# output as an fpath file (compinit autoloads it lazily). The cache is stamped
# with the binary's own mtime and regenerated whenever the two differ: packages
# and tarballs keep old build-time mtimes, so a plain "newer than" test misses
# upgrades. Must run before oh-my-zsh's compinit.
zmodload -F zsh/stat b:zstat
zsh_completions_dir="$HOME/.cache/zsh/completions"
[[ -d "$zsh_completions_dir" ]] || mkdir -p "$zsh_completions_dir"
fpath=("$zsh_completions_dir" $fpath)

function cache_completion() {
  local name="$1"
  local bin="${commands[$name]}"
  local cache="$zsh_completions_dir/_$name"
  local tmp="$cache.$$"
  local -a bin_mtime cache_mtime

  [[ -n "$bin" ]] || return 0
  zstat -A bin_mtime +mtime "$bin"
  zstat -A cache_mtime +mtime "$cache" 2>/dev/null
  [[ "$bin_mtime" == "$cache_mtime" ]] && return 0

  # Build aside and rename, so a parallel shell's compinit never reads a partial file.
  # A failed or empty run keeps the old cache and retries on the next start.
  "$bin" "${@:2}" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]] \
    && touch --reference="$bin" "$tmp" \
    && command mv -f "$tmp" "$cache" \
    || command rm -f "$tmp"
}

cache_completion gh completion --shell zsh
cache_completion kubectl completion zsh
cache_completion helm completion zsh
cache_completion hcloud completion zsh
cache_completion asdf completion zsh

alias hr='heroku'
alias flatpak-flutter='docker run --rm -v "$PWD":/usr/src/flatpak -u `id -u`:`id -g` theappgineer/flatpak-flutter:latest'

alias upgrade='sudo apt update && sudo apt upgrade && sudo snap refresh && flatpak update -y'

alias v="nvim"
alias vv="nvim"
alias vg="nvim +G"
alias ez='nvim ~/.zshrc'
alias sz='source ~/.zshenv && source ~/.zshrc'
alias ck='nvim ~/.sdai/cookies'
alias tma='tmux -2 a'
alias mkdir='mkdir -v'
alias lg='lazygit'
alias ldk='lazydocker'
alias dbui='nvim -c "DBUI"'
alias oil='nvim -c "Oil"'
if [[ -n ${WAYLAND_DISPLAY-} ]]; then
  alias pbcopy='wl-copy'
  alias pbpaste='wl-paste'
else
  alias pbcopy='xclip -sel c'
  alias pbpaste='xclip -sel c -o'
fi
alias nr='newsraft'

### suffer from slop
alias cl='claude'
alias cr='claude -r'
alias cls='claude --model sonnet'

function rm() {
  emulate -L zsh

  if [[ -t 0 ]]; then
    local -a targets
    local arg reply
    for arg in "$@"; do
      [[ "$arg" == -* ]] || targets+=("${arg:A}")
    done

    if (( $#targets )); then
      print -u2 "rm:"
      printf '    %s\n' $targets >&2
      read -r "reply?    confirm? [y/N] "
      if [[ "$reply" != [yY]* ]]; then
        print -u2 "    aborted."
        return 1
      fi
    fi
  fi

  command rm "$@"
}

### endenvs

source $ZSH/oh-my-zsh.sh

# Edit commands using vi bindings -- better than `set -o vi`
bindkey -v

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# For fzf
source /usr/share/doc/fzf/examples/key-bindings.zsh
source /usr/share/doc/fzf/examples/completion.zsh

function __tmux_fzf_autocomplete__() {
  tmux capture-pane -pS -100000 \
    | awk 'BEGIN { RS = "[ \t\n]" } length($0) > 4 && !seen[$0]++' \
    | fzf --no-sort --exact +i --tac --layout reverse --height 20
}

function __tmux_fzf_autocomplete_widget__() {
  LBUFFER+="$(__tmux_fzf_autocomplete__)"
  zle redisplay
}

zle -N __tmux_fzf_autocomplete_widget__
bindkey '^n' __tmux_fzf_autocomplete_widget__

# Automatically create a new session
# tmux has-session -t main 2> /dev/null || tmux new-session -d -s main

eval "$(zoxide init zsh)"
eval "$(starship init zsh)"

# OSC 133 prompt marks for tmux copy-last-output (prefix+O); starship won't emit them (starship#5463).
# A must ride inside PROMPT: a precmd-printed mark dies when zle redraws the prompt line.
if [[ -z "$__osc133_done" ]]; then
  __osc133_done=1
  PROMPT=$'%{\e]133;A\e\\%}'"$PROMPT"
  __osc133_c() { print -n '\e]133;C\e\\' }
  preexec_functions+=(__osc133_c)
fi

# tmux.service starts at boot (linger), so restored shells predate the compositor.
# tmux refreshes WAYLAND_DISPLAY in the session env on attach; pull it into this shell.
if [[ -n $TMUX ]]; then
  _tmux_refresh_wayland() { eval "$(tmux show-environment -s WAYLAND_DISPLAY 2>/dev/null)" }
  preexec_functions+=(_tmux_refresh_wayland)
fi

complete -C '/usr/local/bin/aws_completer' aws
